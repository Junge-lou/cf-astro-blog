---
import { siteConfig } from "@/lib/types";

interface Props {
	slug: string;
	title: string;
}

const commentsConfig = siteConfig.comments;
const { slug, title } = Astro.props as Props;
const isMomoReady = Boolean(commentsConfig.apiUrl);
const momoSlugId = `blog/${slug}`;
---

<section
	class="comments-section"
	data-comments-panel
	data-comments-ready={isMomoReady ? "true" : "false"}
	data-comments-provider="momo"
	data-comments-lang={commentsConfig.lang}
	data-comments-api-url={commentsConfig.apiUrl}
	data-comments-title={title}
	data-comments-slug-id={momoSlugId}
	aria-labelledby="comments-section-title"
>
	<div class="comments-head">
		<h3 class="comments-title" id="comments-section-title">评论</h3>
		<span class="comments-hint">欢迎留言交流</span>
	</div>

	{isMomoReady ? (
		<div class="comments-host" data-comments-host>
			<div class="comments-skeleton" aria-hidden="true">
				<span class="comments-skeleton-line"></span>
				<span class="comments-skeleton-line"></span>
				<span class="comments-skeleton-line comments-skeleton-line-short"></span>
			</div>
		</div>
	) : (
		<p class="comments-empty">评论暂未开放。</p>
	)}
</section>

<script is:inline src="/comments.js"></script>

<style>
	/*
	 * 评论区不再自带边框/背景/圆角，也不再折叠：它是「回应」卡片里的内容块，
	 * 外层 .article-responses 已经是唯一的玻璃面板（避免卡片套卡片）。
	 */
	.comments-section {
		display: grid;
		gap: 0.85rem;
	}

	.comments-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
	}

	.comments-title {
		margin: 0;
		font-family: var(--font-strong);
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--color-text);
	}

	.comments-hint {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.comments-host {
		min-height: 5rem;
		color: var(--color-text);
	}

	.comments-empty {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: 1.7;
	}

	/* 组件脚本与样式注入完成前的占位，避免首屏高度跳变 */
	.comments-skeleton {
		display: grid;
		gap: 0.55rem;
		padding-block: 0.35rem;
	}

	.comments-skeleton-line {
		height: 0.75rem;
		border-radius: 999px;
		background: rgba(var(--card-sheen-rgb), 0.14);
		animation: comments-skeleton-pulse 1.6s ease-in-out infinite;
	}

	.comments-skeleton-line-short {
		width: 62%;
	}

	:global(.comments-error) {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: 1.7;
	}

	@keyframes comments-skeleton-pulse {
		0%,
		100% {
			opacity: 0.5;
		}

		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.comments-skeleton-line {
			animation: none;
		}
	}
</style>
