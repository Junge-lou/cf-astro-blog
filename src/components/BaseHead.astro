---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/lib/types";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
}

const { title, description = siteConfig.description, image, canonicalUrl } = Astro.props;

const fullTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const resolvedUrl = canonicalUrl || Astro.url.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0047ab" />
<meta name="theme-color" content="#6b9bff" media="(prefers-color-scheme: dark)" />
<ClientRouter />

<!-- 字体：西文由 @fontsource 的 CSS 引入（文件名带内容哈希，无法在此写死 preload 路径），
     CJK 一律走系统字体、不下载任何网络字体 —— 详见 src/styles/global.css 的说明。 -->

<!-- DNS 预解析：外部资源域名 -->
<link rel="dns-prefetch" href="https://ffaff-1387930382.cos.ap-guangzhou.myqcloud.com" />
<link rel="dns-prefetch" href="https://challenges.cloudflare.com" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedUrl} />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
<link rel="webmention" href="https://webmention.io/ffaff.fun/webmention" />
<link rel="pingback" href="https://webmention.io/ffaff.fun/xmlrpc" />
<link rel="me" href="https://github.com/Junge-lou" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={resolvedUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={image} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
