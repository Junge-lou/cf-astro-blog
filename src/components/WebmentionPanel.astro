---
interface Props {
	targetUrl: string;
}

const { targetUrl } = Astro.props;
---

<div
	class="wm-section"
	data-webmention-panel
	data-webmention-target={targetUrl}
>
	<h3 class="wm-title" data-wm-title>🔗 Webmentions</h3>
	<div class="wm-list" data-wm-list>
		<div class="wm-loading">加载中…</div>
	</div>
</div>

<script is:inline>
	function initWebmentionPanel() {
		const panels = document.querySelectorAll("[data-webmention-panel]");
		if (panels.length === 0) return;

		panels.forEach((panel) => {
			const list = panel.querySelector("[data-wm-list]");
			const titleEl = panel.querySelector("[data-wm-title]");
			const targetUrl = panel.dataset.webmentionTarget;
			if (!list || !targetUrl) return;
			if (panel.dataset.wmLoaded === "true") return;
			panel.dataset.wmLoaded = "true";

			const encodedTarget = encodeURIComponent(targetUrl);

			fetch("https://webmention.io/api/mentions.jf2?target=" + encodedTarget)
				.then(function (r) { return r.json(); })
				.then(function (data) {
					var mentions = [];
					if (data && data.children) {
						data.children.forEach(function (child) {
							mentions.push({
								type: child["wm-property"] || "mention-of",
								authorName: child.author ? child.author.name || "Anonymous" : "Anonymous",
								authorPhoto: child.author ? child.author.photo || null : null,
								authorUrl: child.author ? child.author.url || null : null,
								url: child.url || null,
								content: child.content ? (child.content.text || child.content.html || null) : null,
								published: child.published || null,
							});
						});
					}

					var html = "";
					// Update heading count
					if (titleEl) {
						titleEl.textContent = "🔗 Webmentions (" + mentions.length + ")";
					}

					if (mentions.length === 0) {
						html = '<div class="wm-empty">暂无 Webmentions</div>';
					} else {
						mentions.forEach(function (m) {
							var typeLabel = getTypeLabel(m.type);
							var name = escHtml(m.authorName);
							var avatarHtml = m.authorPhoto
								? '<img src="' + escAttr(m.authorPhoto) + '" alt="" class="wm-avatar" loading="lazy" />'
								: '<span class="wm-avatar-fallback">' + escHtml(m.authorName.slice(0, 1).toUpperCase()) + '</span>';
							var link = m.authorUrl || m.url || "#";
							var text = m.content
								? escHtml(truncate(stripHtml(m.content), 280))
								: "";
							var time = m.published ? fmtRelative(m.published) : "";

							html += '<a href="' + escAttr(link) + '" target="_blank" rel="nofollow noopener" class="wm-card">';
							html += '<div class="wm-card-head">' + avatarHtml + '<div class="wm-card-info"><span class="wm-author">' + name + '</span>';
							if (time) html += '<span class="wm-meta">' + time + '</span>';
							html += '</div><span class="wm-badge">' + typeLabel + '</span></div>';
							if (text) html += '<div class="wm-content">' + text + '</div>';
							html += '</a>';
						});
					}

					html += '<div class="wm-hint">本站支持 <a href="https://www.w3.org/TR/webmention/" target="_blank" rel="noopener">Webmention</a>。如果你 <button type="button" class="wm-quote-btn" data-wm-quote>引用这篇文章</button>，可以通过下方表单通知我，互动会显示在这里。</div>';
					html += '<div class="wm-form">';
					html += '<div class="wm-form-label">发送 Webmention</div>';
					html += '<div class="wm-form-row">';
					html += '<input type="url" class="wm-input" placeholder="https://example.com/your-post" data-wm-source />';
					html += '<input type="hidden" data-wm-target value="' + escAttr(targetUrl) + '" />';
					html += '<button type="button" class="wm-submit" data-wm-send>发送</button>';
					html += '</div><div class="wm-form-status" data-wm-status></div></div>';

					list.innerHTML = html;

					var sendBtn = list.querySelector("[data-wm-send]");
					var sourceInput = list.querySelector("[data-wm-source]");
					var targetInput = list.querySelector("[data-wm-target]");
					var statusEl = list.querySelector("[data-wm-status]");
					if (sendBtn && sourceInput && targetInput && statusEl) {
						sendBtn.addEventListener("click", function () {
							var source = sourceInput.value.trim();
							if (!source) {
								statusEl.textContent = "请输入你的文章 URL";
								statusEl.className = "wm-form-status error";
								return;
							}
							try { new URL(source); } catch (e) {
								statusEl.textContent = "请输入有效的 URL";
								statusEl.className = "wm-form-status error";
								return;
							}
							sendBtn.disabled = true;
							sendBtn.textContent = "发送中…";
							statusEl.textContent = "";
							statusEl.className = "wm-form-status";
							var formData = new URLSearchParams();
							formData.set("source", source);
							formData.set("target", targetInput.value);
							fetch("https://webmention.io/ffaff.fun/webmention", {
								method: "POST",
								headers: { "Content-Type": "application/x-www-form-urlencoded" },
								body: formData.toString(),
							}).then(function (resp) { return resp.text(); })
								.then(function (result) {
									statusEl.textContent = "发送成功！稍后刷新即可看到。";
									statusEl.className = "wm-form-status";
									sourceInput.value = "";
									sendBtn.disabled = false;
									sendBtn.textContent = "发送";
								}).catch(function () {
									statusEl.textContent = "网络错误，请稍后重试";
									statusEl.className = "wm-form-status error";
									sendBtn.disabled = false;
									sendBtn.textContent = "发送";
								});
						});
					}

					// "引用这篇文章" 复制按钮
					var quoteBtn = list.querySelector("[data-wm-quote]");
					if (quoteBtn) {
						quoteBtn.addEventListener("click", function () {
							var title = document.title.replace(/ · .*$/, "");
							var citation = title + " " + targetUrl;
							if (navigator.clipboard) {
								navigator.clipboard.writeText(citation).then(function () {
									quoteBtn.textContent = "✓ 已复制";
									setTimeout(function () { quoteBtn.textContent = "引用这篇文章"; }, 2000);
								});
							}
						});
					}
				})
				.catch(function () {
					list.innerHTML = '<div class="wm-empty">加载失败，请刷新页面重试</div>';
				});
		});
	}

	function getTypeLabel(type) {
		if (type === "like-of") return "喜欢";
		if (type === "repost-of") return "转发";
		if (type === "in-reply-to") return "回复";
		if (type === "bookmark-of") return "收藏";
		return "提及";
	}

	function escHtml(text) {
		var div = document.createElement("div");
		div.appendChild(document.createTextNode(text));
		return div.innerHTML;
	}

	function escAttr(text) {
		return text.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
	}

	function stripHtml(html) {
		var div = document.createElement("div");
		div.innerHTML = html;
		return div.textContent || div.innerText || "";
	}

	function truncate(text, max) {
		return text.length <= max ? text : text.slice(0, max) + "…";
	}

	function fmtRelative(dateStr) {
		var d = new Date(dateStr);
		if (isNaN(d.getTime())) return "";
		var diff = Date.now() - d.getTime();
		var sec = Math.floor(diff / 1000);
		if (sec < 60) return "刚刚";
		var min = Math.floor(sec / 60);
		if (min < 60) return min + " 分钟前";
		var hr = Math.floor(min / 60);
		if (hr < 24) return hr + " 小时前";
		var days = Math.floor(hr / 24);
		if (days < 30) return days + " 天前";
		if (days < 365) return Math.floor(days / 30) + " 个月前";
		return Math.floor(days / 365) + " 年前";
	}

	document.addEventListener("astro:page-load", initWebmentionPanel);
	document.addEventListener("DOMContentLoaded", initWebmentionPanel);
	initWebmentionPanel();
</script>

<style>
	.wm-section {
		margin: 0;
	}

	.wm-title {
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-align: center;
		color: rgba(255, 255, 255, 0.4);
		margin: 0 0 1rem;
	}

	.wm-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 500px;
		margin: 0 auto;
	}

	.wm-loading,
	.wm-empty {
		text-align: center;
		color: rgba(255, 255, 255, 0.35);
		font-size: 0.9rem;
		padding: 1rem 0;
	}

	.wm-card {
		display: block;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 0.9rem 1rem;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease;
	}

	.wm-card:hover {
		border-color: rgba(255, 255, 255, 0.18);
	}

	.wm-card-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.wm-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
		border: 1px solid rgba(255, 255, 255, 0.1);
		flex-shrink: 0;
	}

	.wm-avatar-fallback {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		font-size: 1.1rem;
		font-weight: 600;
		flex-shrink: 0;
	}

	.wm-card-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.wm-author {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.9);
	}

	.wm-meta {
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.38);
	}

	.wm-badge {
		margin-left: auto;
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.75rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.wm-content {
		margin: 0.6rem 0 0;
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.wm-hint {
		margin: 1rem 0 0;
		text-align: center;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.35);
		line-height: 1.6;
	}

	.wm-hint a {
		color: rgba(255, 255, 255, 0.5);
	}

	.wm-quote-btn {
		display: inline;
		padding: 0.1rem 0.6rem;
		margin: 0 0.15rem;
		font-size: 0.8rem;
		font-family: inherit;
		color: rgba(255, 255, 255, 0.55);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 4px;
		cursor: pointer;
		vertical-align: baseline;
		transition: all 0.2s;
	}

	.wm-quote-btn:hover {
		color: rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.14);
	}

	.wm-form {
		margin-top: 0.75rem;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 0.9rem 1rem;
	}

	.wm-form-label {
		display: block;
		font-size: 0.85rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.55);
		margin-bottom: 0.5rem;
	}

	.wm-form-row {
		display: flex;
		gap: 0.5rem;
	}

	.wm-input {
		flex: 1;
		min-width: 0;
		padding: 0.45rem 0.75rem;
		font-size: 0.9rem;
		font-family: inherit;
		color: rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 6px;
		outline: none;
		transition: border-color 0.2s;
	}

	.wm-input:focus {
		border-color: rgba(255, 255, 255, 0.35);
		outline: 2px solid rgba(255, 255, 255, 0.12);
		outline-offset: 1px;
	}

	.wm-input::placeholder {
		color: rgba(255, 255, 255, 0.25);
	}

	.wm-submit {
		flex-shrink: 0;
		padding: 0.45rem 1.25rem;
		font-size: 0.9rem;
		font-weight: 500;
		font-family: inherit;
		color: #fff;
		background: #c0885a;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.2s;
	}

	.wm-submit:hover {
		background: #d49860;
	}

	.wm-submit:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.wm-form-status {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.45);
	}

	.wm-form-status.error {
		color: #f87171;
	}

	@media (max-width: 480px) {
		.wm-form-row {
			flex-direction: column;
		}
		.wm-submit {
			width: 100%;
		}
	}
</style>
