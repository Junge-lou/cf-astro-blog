---
interface Props {
	targetUrl: string;
}

const { targetUrl } = Astro.props;
---

<div
	class="wm-section"
	data-webmention-panel
	data-webmention-target={targetUrl}
>
	<h2 class="wm-title" data-wm-title>
		🔗 Webmentions (<span class="wm-count" data-wm-count>…</span>)
	</h2>
	<div class="wm-list" data-wm-list>
		<div class="wm-loading">加载中…</div>
	</div>
	<div class="wm-empty" data-wm-empty style="display:none">
		<span>暂无 Webmentions</span>
	</div>
	<p class="wm-hint" data-wm-hint>
		本站支持 <a href="https://www.w3.org/TR/webmention/" target="_blank" rel="noopener noreferrer">Webmention</a>。
		如果你 <button type="button" class="wm-quote-btn" data-wm-quote>引用这篇文章</button>，可以通过下方表单通知我，互动会显示在这里。
	</p>
	<form class="wm-form" data-wm-form action="https://webmention.io/ffaff.fun/webmention" method="POST" target="_blank">
		<input type="hidden" name="target" value={targetUrl} />
		<label class="wm-form-label">发送 Webmention</label>
		<div class="wm-form-row">
			<input type="url" name="source" class="wm-input" placeholder="https://example.com/your-post" required />
			<button type="submit" class="wm-submit">发送</button>
		</div>
	</form>
</div>

<script is:inline>
	function initWebmentionPanel() {
		var panels = document.querySelectorAll("[data-webmention-panel]");
		if (panels.length === 0) return;

		panels.forEach(function (panel) {
			var list = panel.querySelector("[data-wm-list]");
			var emptyEl = panel.querySelector("[data-wm-empty]");
			var countEl = panel.querySelector("[data-wm-count]");
			var targetUrl = panel.dataset.webmentionTarget;
			if (!list || !targetUrl) return;
			if (panel.dataset.wmLoaded === "true") return;
			panel.dataset.wmLoaded = "true";

			var targetVariants = buildTargetVariants(targetUrl);
			var queryParts = targetVariants.map(function (t) {
				return "target[]=" + encodeURIComponent(t);
			});
			var queryString = queryParts.join("&");

			fetch("https://webmention.io/api/mentions.jf2?" + queryString)
				.then(function (r) { return r.json(); })
				.then(function (data) {
					var mentions = [];
					if (data && data.children) {
						data.children.forEach(function (child) {
							if (child["wm-private"] === true) return;

							var wmTarget = child["wm-target"] || "";
							try {
								var targetUrlObj = new URL(wmTarget);
								var pageUrlObj = new URL(targetUrl);
								if (targetUrlObj.pathname !== pageUrlObj.pathname) return;
							} catch (e) { return; }

							var contentHtml = child.content ? (child.content.html || "") : "";
							var contentText = child.content ? (child.content.text || "") : "";
							var contextSnippet = extractContext(contentHtml, contentText, targetUrl);
							var wmSource = child["wm-source"] || child.url || "";

							mentions.push({
								type: child["wm-property"] || "mention-of",
								authorName: child.author ? child.author.name || "Anonymous" : "Anonymous",
								authorPhoto: child.author ? child.author.photo || null : null,
								authorUrl: child.author ? child.author.url || null : null,
								url: child.url || wmSource,
								content: contextSnippet || contentText,
								published: child.published || child["wm-received"] || null,
								source: wmSource,
							});
						});
					}

					if (countEl) countEl.textContent = mentions.length;

					var html = "";

					if (mentions.length === 0) {
						list.style.display = "none";
						if (emptyEl) emptyEl.style.display = "";
					} else {
						if (emptyEl) emptyEl.style.display = "none";
						list.style.display = "flex";
						mentions.forEach(function (m) {
							var typeLabel = getTypeLabel(m.type);
							var name = escHtml(m.authorName);
							var domain = getDomain(m.source || m.url || "");
							var avatarHtml = m.authorPhoto
								? '<img src="' + escAttr(m.authorPhoto) + '" alt="" class="wm-avatar" loading="lazy" decoding="async" />'
								: '<span class="wm-avatar-fallback">' + escHtml(m.authorName.slice(0, 1).toUpperCase()) + '</span>';
							var link = m.url || m.source || "#";
							var text = m.content || "";
							var time = m.published ? fmtRelative(m.published) : "";
							var fullDate = m.published ? fmtFullDate(m.published) : "";

							html += '<a href="' + escAttr(link) + '" target="_blank" rel="noopener noreferrer" class="wm-card"';
							if (fullDate) html += ' title="' + escAttr(fullDate) + '"';
							html += '>';
							html += '<div class="wm-card-head">' + avatarHtml;
							html += '<span>';
							html += '<span class="wm-author">' + name + '</span>';
							if (domain || time) html += '<span class="wm-meta"> · ' + [domain, time].filter(Boolean).join(" · ") + '</span>';
							html += '</span>';
							html += '<span class="wm-badge">' + typeLabel + '</span>';
							html += '</div>';
							if (text) html += '<p class="wm-content">' + text + '</p>';
							html += '</a>';
						});
					}

					list.innerHTML = html;

					// Quote button
					var quoteBtn = panel.querySelector("[data-wm-quote]");
					if (quoteBtn) {
						quoteBtn.addEventListener("click", function () {
							var title = document.title.replace(/ · .*$/, "").replace(/ \\| .*$/, "");
							var citation = "[" + title + "](" + targetUrl + ")";
							if (navigator.clipboard) {
								navigator.clipboard.writeText(citation).then(function () {
									quoteBtn.textContent = "✓ 已复制";
									setTimeout(function () { quoteBtn.textContent = "引用这篇文章"; }, 2000);
								}).catch(function () {
									var ta = document.createElement("textarea");
									ta.value = citation;
									ta.style.position = "fixed"; ta.style.opacity = "0";
									document.body.appendChild(ta);
									ta.select();
									document.execCommand("copy");
									document.body.removeChild(ta);
									quoteBtn.textContent = "✓ 已复制";
									setTimeout(function () { quoteBtn.textContent = "引用这篇文章"; }, 2000);
								});
							}
						});
					}
				})
				.catch(function () {
					list.style.display = "none";
					if (emptyEl) { emptyEl.style.display = ""; emptyEl.querySelector("span").textContent = "加载失败，请刷新页面重试"; }
				});
		});
	}

	function buildTargetVariants(url) {
		var variants = [];
		try {
			var u = new URL(url);
			variants.push(u.origin + u.pathname + u.search);
			if (location.hash) variants.push(u.origin + u.pathname + u.search + location.hash);
		} catch (e) { variants.push(url); }
		return variants;
	}

	function extractContext(html, text, targetUrl) {
		if (!html && !text) return "";
		if (html) {
			var div = document.createElement("div");
			div.innerHTML = html;
			var links = div.querySelectorAll("a");
			var pageHost = location.hostname;
			for (var i = 0; i < links.length; i++) {
				var href = links[i].getAttribute("href") || "";
				try {
					var linkHost = new URL(href, location.origin).hostname;
					if (linkHost === pageHost || linkHost === "ffaff.fun") {
						var linkText = links[i].textContent.trim();
						var fullText = div.textContent || "";
						var idx = fullText.indexOf(linkText);
						if (idx !== -1) {
							var ctxLen = 100;
							var start = Math.max(0, idx - ctxLen);
							var end = Math.min(fullText.length, idx + linkText.length + ctxLen);
							var before = fullText.slice(start, idx);
							var after = fullText.slice(idx + linkText.length, end);
							return (start > 0 ? "[…]" : "") + escHtml(before.trim()) + " <mark>" + escHtml(linkText) + "</mark> " + escHtml(after.trim()) + (end < fullText.length ? "[…]" : "");
						}
					}
				} catch (e) {}
			}
		}
		return escHtml(text || "");
	}

	function getDomain(url) {
		try { return new URL(url).hostname.replace(/^www\./, ""); } catch (e) { return ""; }
	}

	function getTypeLabel(type) {
		if (type === "like-of") return "❤️ 喜欢";
		if (type === "repost-of") return "🔄 转发";
		if (type === "in-reply-to") return "💬 回复";
		if (type === "bookmark-of") return "🔖 收藏";
		return "💭 提及";
	}

	function escHtml(text) {
		var div = document.createElement("div");
		div.appendChild(document.createTextNode(text));
		return div.innerHTML;
	}

	function escAttr(text) {
		return text.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
	}

	function fmtRelative(dateStr) {
		var d = new Date(dateStr);
		if (isNaN(d.getTime())) return "";
		var now = new Date();
		var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
		var targetDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
		var dayDiff = Math.round((today.getTime() - targetDay.getTime()) / 86400000);
		if (dayDiff === 0) return "今天";
		if (dayDiff === 1) return "昨天";
		if (dayDiff === 2) return "前天";
		if (dayDiff < 30) return dayDiff + " 天前";
		if (dayDiff < 365) return Math.floor(dayDiff / 30) + " 个月前";
		return Math.floor(dayDiff / 365) + " 年前";
	}

	function fmtFullDate(dateStr) {
		var d = new Date(dateStr);
		if (isNaN(d.getTime())) return "";
		try {
			return new Intl.DateTimeFormat("zh-CN", { dateStyle: "full", timeStyle: "long", timeZone: "Asia/Shanghai" }).format(d);
		} catch (e) { return d.toLocaleString("zh-CN"); }
	}

	document.addEventListener("astro:page-load", initWebmentionPanel);
	document.addEventListener("DOMContentLoaded", initWebmentionPanel);
	initWebmentionPanel();
</script>

<style>
	.wm-section { margin: 0; }

	.wm-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 0.9rem;
		text-align: center;
	}

	.wm-count { font-weight: 400; color: var(--color-text-muted); }

	/* ── 卡片列表 ── */
	.wm-list {
		display: none;
		flex-direction: column;
		gap: 0.75rem;
	}

	.wm-loading,
	.wm-empty {
		text-align: center;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		padding: 1rem 0;
	}

	.wm-loading {
		display: block;
	}

	/* ── 提及卡片 ── */
	.wm-card {
		display: block;
		background-color: rgba(var(--card-surface-rgb), 0.65);
		border: 1px solid rgba(var(--card-surface-rgb), 0.55);
		border-radius: 8px;
		padding: 0.85rem 1rem;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s, background-color 0.2s;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.wm-card:hover {
		border-color: var(--color-accent);
		background-color: rgba(var(--card-surface-rgb), 0.85);
	}

	.wm-card-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.wm-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
		border: 1px solid rgba(var(--card-surface-rgb), 0.5);
		flex-shrink: 0;
	}

	.wm-avatar-fallback {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		font-size: 1rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.wm-card-head > span {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		min-width: 0;
		flex: 1;
	}

	.wm-author {
		font-size: 0.92rem;
		font-weight: 650;
		color: var(--color-text);
	}

	.wm-meta {
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.wm-badge {
		flex-shrink: 0;
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		font-size: 0.73rem;
		font-weight: 500;
		padding: 0.14rem 0.55rem;
		border-radius: 999px;
		white-space: nowrap;
		align-self: flex-start;
	}

	.wm-content {
		margin: 0.55rem 0 0;
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.wm-content mark {
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		padding: 0.04em 0.18em;
		border-radius: 2px;
	}

	/* ── 提示 ── */
	.wm-hint {
		margin: 0.9rem 0 0;
		font-size: 0.84rem;
		color: var(--color-text-muted);
		line-height: 1.7;
	}

	.wm-hint a {
		color: var(--color-accent-hover);
		text-decoration: none;
	}

	.wm-hint a:hover { text-decoration: underline; }

	.wm-quote-btn {
		display: inline;
		padding: 0.08rem 0.55rem;
		margin: 0 0.15rem;
		font-size: 0.78rem;
		font-family: inherit;
		color: var(--color-text-secondary);
		background-color: rgba(var(--card-surface-rgb), 0.6);
		border: 1px solid rgba(var(--card-surface-rgb), 0.55);
		border-radius: 4px;
		cursor: pointer;
		vertical-align: baseline;
		transition: all 0.2s;
	}

	.wm-quote-btn:hover {
		color: var(--color-accent-hover);
		border-color: var(--color-accent);
		background-color: var(--color-accent-soft);
	}

	/* ── 发送表单 ── */
	.wm-form {
		margin-top: 0.65rem;
		background-color: rgba(var(--card-surface-rgb), 0.75);
		border: 1px solid rgba(var(--card-surface-rgb), 0.55);
		border-radius: 8px;
		padding: 0.8rem 1rem;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.wm-form-label {
		display: block;
		font-size: 0.83rem;
		font-weight: 500;
		color: var(--color-text-muted);
		margin-bottom: 0.45rem;
	}

	.wm-form-row {
		display: flex;
		gap: 0.5rem;
	}

	.wm-input {
		flex: 1 1 auto;
		min-width: 0;
		padding: 0.4rem 0.7rem;
		font-size: 0.88rem;
		font-family: inherit;
		color: var(--color-text);
		background-color: rgba(var(--card-surface-rgb), 0.65);
		border: 1px solid rgba(var(--card-surface-rgb), 0.55);
		border-radius: 6px;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.wm-input:focus {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}

	.wm-input::placeholder { color: var(--color-text-placeholder); }

	.wm-submit {
		flex-shrink: 0;
		padding: 0.4rem 1.1rem;
		font-size: 0.88rem;
		font-weight: 600;
		font-family: inherit;
		color: #fff;
		background-color: var(--color-accent);
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background-color 0.2s, transform 0.1s;
	}

	.wm-submit:hover { background-color: var(--color-accent-hover); }
	.wm-submit:active { transform: scale(0.97); }

	@media (max-width: 480px) {
		.wm-form-row { flex-direction: column; }
		.wm-submit { width: 100%; }
	}
</style>
