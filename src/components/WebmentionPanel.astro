---
import { buildMentionsUrl, WEBMENTION_ENDPOINT, WEBMENTION_SITE } from "@/lib/webmention";

interface Props {
	targetUrl: string;
	/** 「回应」侧栏里的紧凑变体：小标题、脚注更短、表单垂直排列 */
	compact?: boolean;
}

const { targetUrl, compact = false } = Astro.props;
const Heading = compact ? "h3" : "h2";
---

<div
	class:list={["wm-section", { "wm-section-compact": compact }]}
	data-webmention-panel
	data-webmention-target={targetUrl}
	data-webmention-api-url={buildMentionsUrl(targetUrl)}
	data-webmention-endpoint={WEBMENTION_ENDPOINT}
	data-webmention-site={WEBMENTION_SITE}
>
	<Heading class:list={["wm-title", { "wm-title-compact": compact }]} data-wm-title>
		🔗 Webmentions (<span class="wm-count" data-wm-count>…</span>)
	</Heading>
	<div class="wm-list" data-wm-list aria-live="polite">
		<div class="wm-loading">加载中…</div>
	</div>
	<div class="wm-empty" data-wm-empty style="display:none">
		<span>暂无 Webmentions</span>
	</div>
	<p class="wm-hint" data-wm-hint>
		{compact ? (
			<span>支持 Webmention；引用本文后通知我，互动会显示在这里。</span>
		) : (
			<>
				本站支持 <a href="https://www.w3.org/TR/webmention/" target="_blank" rel="noopener noreferrer">Webmention</a>。
				如果你 <button type="button" class="wm-quote-btn" data-wm-quote>引用这篇文章</button>，可以通过下方表单通知我，互动会显示在这里。
			</>
		)}
	</p>
	<form class="wm-form" data-wm-form action={WEBMENTION_ENDPOINT} method="POST">
		<input type="hidden" name="target" value={targetUrl} />
		<label class="wm-form-label" for="wm-source">发送 Webmention</label>
		<div class="wm-form-row">
			<input
				id="wm-source"
				type="url"
				name="source"
				class="wm-input"
				placeholder="https://example.com/your-post"
				required
			/>
			<button type="submit" class="wm-submit">发送</button>
		</div>
		<p class="wm-status" data-wm-status role="status" aria-live="polite"></p>
	</form>
</div>

<script is:inline>
	function initWebmentionPanel() {
		var panels = document.querySelectorAll("[data-webmention-panel]");
		if (panels.length === 0) return;

		panels.forEach(function (panel) {
			var list = panel.querySelector("[data-wm-list]");
			var emptyEl = panel.querySelector("[data-wm-empty]");
			var countEl = panel.querySelector("[data-wm-count]");
			var targetUrl = panel.dataset.webmentionTarget;
			var apiUrl = panel.dataset.webmentionApiUrl;
			var endpoint = panel.dataset.webmentionEndpoint;
			var siteHost = panel.dataset.webmentionSite;
			if (!list || !targetUrl || !apiUrl) return;
			if (panel.dataset.wmLoaded === "true") return;
			panel.dataset.wmLoaded = "true";

			// 引用按钮与发送表单在这里绑定。此前它们写在 fetch 的 .then() 里，
			// 于是 webmention.io 一挂，这两个按钮就一起变成死键。
			bindQuoteButton(panel, targetUrl);
			if (endpoint) bindSendForm(panel, endpoint);

			fetchWithTimeout(apiUrl)
				.then(function (r) {
					if (!r.ok) throw new Error("HTTP " + r.status);
					return r.json();
				})
				.then(function (data) {
					var mentions = [];
					if (data && data.children) {
						data.children.forEach(function (child) {
							// 公开的 target 查询不会返回私有 mention，这里保留一道防御性过滤，
							// 以免将来改成 token 查询时误展示。
							if (child["wm-private"] === true) return;

							var contentHtml = child.content ? (child.content.html || "") : "";
							var contentText = child.content ? (child.content.text || "") : "";
							var contextSnippet = extractContext(contentHtml, contentText, siteHost);
							var wmSource = child["wm-source"] || child.url || "";
							var wmProperty = child["wm-property"] || "mention-of";

							// Parse RSVP if present
							var rsvp = child.rsvp || (child.properties && child.properties.rsvp ? child.properties.rsvp[0] : null);

							mentions.push({
								type: wmProperty,
								rsvp: rsvp,
								authorName: child.author ? child.author.name || "Anonymous" : "Anonymous",
								authorPhoto: child.author ? child.author.photo || null : null,
								authorUrl: child.author ? child.author.url || null : null,
								url: child.url || wmSource,
								content: contextSnippet || contentText,
								published: child.published || child["wm-received"] || null,
								source: wmSource,
							});
						});
					}

					// Group by type for summary & rendering
					var groups = { likes: [], reposts: [], replies: [], bookmarks: [], mentions: [], rsvps: [] };
					mentions.forEach(function (m) {
						if (m.type === "like-of") groups.likes.push(m);
						else if (m.type === "repost-of") groups.reposts.push(m);
						else if (m.type === "in-reply-to") groups.replies.push(m);
						else if (m.type === "bookmark-of") groups.bookmarks.push(m);
						else if (m.type === "rsvp") groups.rsvps.push(m);
						else groups.mentions.push(m);
					});

					// `per-page` 最多 1000，`total` 是匹配总数；只拿 children.length 当总数会在
					// 超过单页上限后低报，而且不给任何提示。
					var paging = data && data.paging ? data.paging : null;
					var total =
						paging && typeof paging.total === "number" ? paging.total : mentions.length;
					var shown = mentions.length;
					if (countEl) countEl.textContent = String(total);

					var html = "";

					if (total === 0) {
						list.style.display = "none";
						if (emptyEl) emptyEl.style.display = "";
					} else {
						if (emptyEl) emptyEl.style.display = "none";
						list.style.display = "flex";

						// ── Summary bar ──
						var summaryParts = [];
						if (groups.likes.length) summaryParts.push('<span class="wm-summary-item">❤️ ' + groups.likes.length + ' 人喜欢</span>');
						if (groups.reposts.length) summaryParts.push('<span class="wm-summary-item">🔄 ' + groups.reposts.length + ' 人转发</span>');
						if (groups.replies.length) summaryParts.push('<span class="wm-summary-item">💬 ' + groups.replies.length + ' 条回复</span>');
						if (groups.bookmarks.length) summaryParts.push('<span class="wm-summary-item">🔖 ' + groups.bookmarks.length + ' 人收藏</span>');
						if (groups.rsvps.length) summaryParts.push('<span class="wm-summary-item">📅 ' + groups.rsvps.length + ' 人回应</span>');
						if (groups.mentions.length) summaryParts.push('<span class="wm-summary-item">💭 ' + groups.mentions.length + ' 次提及</span>');
						if (total > shown) summaryParts.push('<span class="wm-summary-item">仅显示最近 ' + shown + ' 条</span>');
						if (summaryParts.length) {
							html += '<div class="wm-summary">' + summaryParts.join("") + '</div>';
						}

						// ── Facepile: likes + reposts + bookmarks ──
						var facepileMentions = groups.likes.concat(groups.reposts).concat(groups.bookmarks).concat(groups.rsvps);
						// deduplicate by author URL
						var seenAuthors = {};
						var uniqueFacepile = [];
						facepileMentions.forEach(function (m) {
							var key = m.authorUrl || m.authorName || m.source;
							if (!seenAuthors[key]) {
								seenAuthors[key] = true;
								uniqueFacepile.push(m);
							}
						});
						if (uniqueFacepile.length) {
							html += '<div class="wm-facepile">';
							uniqueFacepile.forEach(function (m, i) {
								var link = m.authorUrl || m.url || m.source || "#";
								var photoHtml = m.authorPhoto
									? '<img src="' + escAttr(m.authorPhoto) + '" alt="' + escAttr(m.authorName) + '" class="wm-facepile-avatar" loading="lazy" decoding="async" referrerpolicy="no-referrer" />'
									: '<span class="wm-facepile-avatar wm-facepile-fallback">' + escHtml(m.authorName.slice(0, 1).toUpperCase()) + '</span>';
								var typeIcon = m.type === "like-of" ? "❤️" : m.type === "repost-of" ? "🔄" : m.type === "bookmark-of" ? "🔖" : m.type === "rsvp" ? getRsvpEmoji(m.rsvp) : "💭";
								var title = escAttr(m.authorName + " " + getTypeLabel(m.type, m.rsvp));
								html += '<a href="' + escAttr(link) + '" target="_blank" rel="nofollow ugc noopener noreferrer" class="wm-facepile-item" title="' + title + '" aria-label="' + title + '" style="z-index:' + (uniqueFacepile.length - i) + '">';
								html += photoHtml;
								html += '<span class="wm-facepile-icon">' + typeIcon + '</span>';
								html += '</a>';
							});
							html += '</div>';
						}

						// ── Cards: replies + generic mentions ──
						var cardMentions = groups.replies.concat(groups.mentions);
						cardMentions.forEach(function (m) {
							var typeLabel = getTypeLabel(m.type, m.rsvp);
							var name = escHtml(m.authorName);
							var domain = getDomain(m.source || m.url || "");
							var avatarHtml = m.authorPhoto
								? '<img src="' + escAttr(m.authorPhoto) + '" alt="" class="wm-avatar" loading="lazy" decoding="async" referrerpolicy="no-referrer" />'
								: '<span class="wm-avatar-fallback">' + escHtml(m.authorName.slice(0, 1).toUpperCase()) + '</span>';
							var link = m.authorUrl || m.url || m.source || "#";
							var text = m.content || "";
							var time = m.published ? fmtRelative(m.published) : "";
							var fullDate = m.published ? fmtFullDate(m.published) : "";

							html += '<div class="wm-card">';
							html += '<div class="wm-card-head">';
							// 头像链到作者站点。旁边的作者名已经提供了可访问名称，所以头像链接
							// 对读屏隐藏并移出 Tab 序列，避免同一个目标被念两遍、停两次。
							html += '<a href="' + escAttr(link) + '" target="_blank" rel="nofollow ugc noopener noreferrer" class="wm-avatar-link" aria-hidden="true" tabindex="-1">' + avatarHtml + '</a>';
							html += '<span class="wm-card-meta">';
							html += '<a href="' + escAttr(link) + '" target="_blank" rel="nofollow ugc noopener noreferrer" class="wm-author-link"><span class="wm-author">' + name + '</span></a>';
							if (domain || time) html += '<span class="wm-meta"> · ' + [domain, time].filter(Boolean).join(" · ") + '</span>';
							html += '</span>';
							html += '<span class="wm-badge">' + typeLabel + '</span>';
							html += '</div>';
							if (text) html += '<div class="wm-content">' + text + '</div>';
							if (fullDate) html += '<a href="' + escAttr(m.url || m.source || "#") + '" target="_blank" rel="nofollow ugc noopener noreferrer" class="wm-time-link"><time class="wm-time" datetime="' + escAttr(m.published || "") + '" title="' + escAttr(fullDate) + '">' + escHtml(fullDate) + '</time></a>';
							html += '</div>';
						});
					}

					list.innerHTML = html;
				})
				.catch(function () {
					// 必须与「真的没有人提及」区分开：把失败渲染成「暂无 Webmentions」
					// 会让站长误以为文章没人引用。
					list.style.display = "none";
					if (countEl) countEl.textContent = "—";
					if (emptyEl) {
						emptyEl.style.display = "";
						var label = emptyEl.querySelector("span");
						if (label) label.textContent = "Webmention 加载失败，稍后刷新重试";
					}
				});
		});
	}

	// 8 秒足够慢网，又不至于让「加载中…」一直挂着。
	var WM_TIMEOUT_MS = 8000;

	function fetchWithTimeout(url) {
		if (typeof AbortController !== "function") return fetch(url);
		var controller = new AbortController();
		var timer = setTimeout(function () { controller.abort(); }, WM_TIMEOUT_MS);
		return fetch(url, { signal: controller.signal }).then(
			function (response) {
				clearTimeout(timer);
				return response;
			},
			function (error) {
				clearTimeout(timer);
				throw error;
			},
		);
	}

	function setStatus(el, text, state) {
		if (!el) return;
		el.textContent = text;
		el.dataset.state = state || "";
	}

	// 官方在 source/target 对上做 30 秒限流，队列满时返回 503；不把这几种状态
	// 翻译出来，读者就只能在开发者工具里猜了。
	function describeFailure(status) {
		if (status === 429) return "提交太频繁了（同一来源 30 秒内只能发一次），稍后再试。";
		if (status === 503) return "对方队列满了，稍后再试。";
		if (status === 400) return "对方不认这个地址，请填你引用本页那篇文章的网址。";
		return "提交失败（HTTP " + status + "），稍后再试。";
	}

	function readResult(response) {
		return { ok: response.ok, status: response.status };
	}

	function postWebmention(endpoint, source, target) {
		var body = new URLSearchParams();
		body.set("source", source);
		body.set("target", target);

		var request = {
			method: "POST",
			headers: { "Content-Type": "application/x-www-form-urlencoded" },
			body: body.toString(),
		};

		if (typeof AbortController !== "function") {
			return fetch(endpoint, request).then(readResult);
		}

		var controller = new AbortController();
		var timer = setTimeout(function () { controller.abort(); }, WM_TIMEOUT_MS);
		request.signal = controller.signal;
		return fetch(endpoint, request).then(
			function (response) {
				clearTimeout(timer);
				return readResult(response);
			},
			function (error) {
				clearTimeout(timer);
				throw error;
			},
		);
	}

	/**
	 * 发送 Webmention。
	 *
	 * 原生表单提交在 CSP 下需要额外放行 `form-action`，且提交会抡走用户
	 * （target=_blank 时是开一个新标签页看裸 JSON）。这里改成 fetch，
	 * 把 201 / 429 / 503 就地变成一行中文提示；表单本身保留，作为无 JS 时的兜底。
	 */
	function bindSendForm(panel, endpoint) {
		var form = panel.querySelector("[data-wm-form]");
		var statusEl = panel.querySelector("[data-wm-status]");
		if (!form || form.dataset.wmBound === "true") return;
		form.dataset.wmBound = "true";

		form.addEventListener("submit", function (event) {
			var sourceInput = form.querySelector('input[name="source"]');
			var targetInput = form.querySelector('input[name="target"]');
			var source = sourceInput ? String(sourceInput.value).trim() : "";
			var target = targetInput ? String(targetInput.value) : "";
			// 空值/非法 URL 交给浏览器原生校验提示，不要抢它的活。
			if (!source) return;

			event.preventDefault();
			var button = form.querySelector(".wm-submit");
			if (button) button.disabled = true;
			setStatus(statusEl, "正在提交…", "pending");

			postWebmention(endpoint, source, target)
				.then(function (result) {
					if (result.ok) {
						setStatus(statusEl, "已提交。对方验证通过后会显示在这里。", "ok");
						form.reset();
					} else {
						setStatus(statusEl, describeFailure(result.status), "error");
					}
				})
				.catch(function () {
					setStatus(statusEl, "网络异常，没能提交；稍后再试。", "error");
				})
				.then(function () {
					if (button) button.disabled = false;
				});
		});
	}

	function bindQuoteButton(panel, targetUrl) {
		var button = panel.querySelector("[data-wm-quote]");
		if (!button || button.dataset.wmBound === "true") return;
		button.dataset.wmBound = "true";

		button.addEventListener("click", function () {
			var rawTitle = document.title.replace(/ · .*$/, "").replace(/ \| .*$/, "");
			var citation = "[" + rawTitle + "](" + targetUrl + ")";
			copyText(citation).then(function (copied) {
				button.textContent = copied ? "✓ 已复制" : "复制失败，请手动复制";
				setTimeout(function () { button.textContent = "引用这篇文章"; }, 2000);
			});
		});
	}

	/**
	 * 复制文本。优先异步剪贴板 API，没有权限或不支持时退回选中 + execCommand。
	 * 旧版把兜底写在 promise 的 catch 里，于是「浏览器没有 navigator.clipboard」
	 * 时按钮点了完全没反应。
	 */
	function copyText(text) {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			return navigator.clipboard.writeText(text).then(
				function () { return true; },
				function () { return legacyCopy(text); },
			);
		}
		return Promise.resolve(legacyCopy(text));
	}

	function legacyCopy(text) {
		try {
			var area = document.createElement("textarea");
			area.value = text;
			area.setAttribute("readonly", "");
			area.style.position = "fixed";
			area.style.top = "-1000px";
			document.body.appendChild(area);
			area.select();
			var ok = document.execCommand("copy");
			document.body.removeChild(area);
			return ok;
		} catch (e) {
			return false;
		}
	}

	function extractContext(html, text, siteHost) {
		if (!html && !text) return "";
		if (html) {
			// 用 DOMParser 而不是 div.innerHTML：解析结果是**惰性文档**，
			// 图片不会发起请求、脚本不会执行。远端 HTML 只用于定位「链接回本站」
			// 的那个锚点，不需要它变成真正的 DOM 节点。
			var doc = null;
			try {
				doc = new DOMParser().parseFromString(html, "text/html");
			} catch (e) {
				doc = null;
			}
			var links = doc ? doc.querySelectorAll("a") : [];
			for (var i = 0; i < links.length; i++) {
				var href = links[i].getAttribute("href") || "";
				try {
					var linkHost = new URL(href, location.origin).hostname;
					if (linkHost === siteHost) {
						var linkText = links[i].textContent.trim();
						var fullText = doc.textContent || "";
						var idx = fullText.indexOf(linkText);
						if (idx !== -1) {
							var ctxLen = 100;
							var start = Math.max(0, idx - ctxLen);
							var end = Math.min(fullText.length, idx + linkText.length + ctxLen);
							var before = fullText.slice(start, idx);
							var after = fullText.slice(idx + linkText.length, end);
							return (start > 0 ? "[…]" : "") + escHtml(before.trim()) + " <mark>" + escHtml(linkText) + "</mark> " + escHtml(after.trim()) + (end < fullText.length ? "[…]" : "");
						}
					}
				} catch (e) {}
			}
		}
		return escHtml(text || "");
	}

	function getDomain(url) {
		try { return new URL(url).hostname.replace(/^www\./, ""); } catch (e) { return ""; }
	}

	function getTypeLabel(type, rsvp) {
		if (type === "like-of") return "❤️ 喜欢";
		if (type === "repost-of") return "🔄 转发";
		if (type === "in-reply-to") return "💬 回复";
		if (type === "bookmark-of") return "🔖 收藏";
		if (type === "rsvp") return getRsvpLabel(rsvp);
		return "💭 提及";
	}

	function getRsvpLabel(rsvp) {
		if (rsvp === "yes") return "✅ 参加";
		if (rsvp === "no") return "❌ 不参加";
		if (rsvp === "maybe") return "🤔 可能";
		if (rsvp === "interested") return "⭐ 感兴趣";
		return "📅 RSVP";
	}

	function getRsvpEmoji(rsvp) {
		if (rsvp === "yes") return "✅";
		if (rsvp === "no") return "❌";
		if (rsvp === "maybe") return "🤔";
		if (rsvp === "interested") return "⭐";
		return "📅";
	}

	/**
	 * 统一的转义函数。
	 *
	 * `escHtml` / `escAttr` 两个名字保留是因为调用点很多，但实现只有一个：
	 * 旧版 `escHtml` 用 `div.innerHTML` 反推转义串且**不转引号**，一旦某个值被
	 * 插进属性就破防。文本节点多转义几个字符没有副作用。
	 */
	function escapeHtml(value) {
		return String(value === null || value === undefined ? "" : value)
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#39;");
	}

	function escHtml(value) {
		return escapeHtml(value);
	}

	function escAttr(value) {
		return escapeHtml(value);
	}

	function fmtRelative(dateStr) {
		var d = new Date(dateStr);
		if (isNaN(d.getTime())) return "";
		var now = new Date();
		var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
		var targetDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
		var dayDiff = Math.round((today.getTime() - targetDay.getTime()) / 86400000);
		if (dayDiff === 0) return "今天";
		if (dayDiff === 1) return "昨天";
		if (dayDiff === 2) return "前天";
		if (dayDiff < 30) return dayDiff + " 天前";
		if (dayDiff < 365) return Math.floor(dayDiff / 30) + " 个月前";
		return Math.floor(dayDiff / 365) + " 年前";
	}

	function fmtFullDate(dateStr) {
		var d = new Date(dateStr);
		if (isNaN(d.getTime())) return "";
		try {
			return new Intl.DateTimeFormat("zh-CN", { dateStyle: "full", timeStyle: "long", timeZone: "Asia/Shanghai" }).format(d);
		} catch (e) { return d.toLocaleString("zh-CN"); }
	}

	document.addEventListener("astro:page-load", initWebmentionPanel);
	document.addEventListener("DOMContentLoaded", initWebmentionPanel);
	initWebmentionPanel();
</script>

<style>
	.wm-section { margin: 0; }

	.wm-title {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 0.9rem;
		text-align: center;
