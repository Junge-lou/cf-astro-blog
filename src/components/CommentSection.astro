---
/**
 * 评论区（Momo-Backend）。
 *
 * 挂载的是官方前端组件，本站不做任何数据读写：`momo.init()` 之后，列表拉取、
 * 提交、无感验证全由 bundle 自己完成。这里只负责三件事：
 * 1. 提供挂载点与 data-* 配置（地址来源见 `@/lib/comment`）；
 * 2. 把组件的 `--momo-*` 配色变量映射到本站 token；
 * 3. 无 JS / 加载失败时的可读兜底。
 *
 * 样式注意：bundle 的 CSS 是运行时注入的，Astro 的 scoped 属性加不到它生成的
 * DOM 上。要改子元素结构必须用 `:global()`；只改颜色时优先改 `--momo-*`
 * 自定义属性（自定义属性会继承进子 DOM，不需要 `:global()`）。
 */
import { MOMO_COMMENT_API_URL, MOMO_COMMENT_SCRIPT_URL } from "@/lib/comment";

interface Props {
	/** 文章唯一标识，与后端 `Comment.post_slug` 对应 */
	slug: string;
	/** 通知邮件/后台列表里显示的文章标题 */
	title: string;
	lang?: string;
}

const { slug, title, lang = "zh-cn" } = Astro.props;
---

<div
	class="comment-section"
	id="comment-area"
	data-momo-comment-section
	data-api-url={MOMO_COMMENT_API_URL}
	data-script-url={MOMO_COMMENT_SCRIPT_URL}
	data-slug-id={slug}
	data-post-title={title}
	data-lang={lang}
>
	{/* 挂载点必须带 id：momo.init({ el }) 内部用 querySelector 定位 */}
	<div id="momo-comment" class="momo-comment-root" data-momo-comment-root></div>
	<noscript>
		<p class="comment-fallback">评论区需要 JavaScript；你也可以通过下方的 Webmention 回应。</p>
	</noscript>
</div>

<script is:inline>
	/*
	 * 评论组件引导（内联，**不要**再拆成 public/*.js）
	 * ───────────────────────────────────────────────
	 * 之前它是 public/momo-comments.js，独立文件意味着独立缓存：那份文件按
	 * `_headers` 缓存一天，于是「部署后代码已更新、访客还在跑昨天的引导逻辑」
	 * —— 表现就是第一次进文章评论区不加载，刷新（拿到新 HTML）后才好。
	 * 内联进 HTML 后，引导脚本与页面同生共死，不可能再出现版本错配，也少一次请求。
	 *
	 * 仍然保留动态注入组件包（而不是直接写 <script src>）：组件包 228KB，
	 * 只有文章页需要，动态注入可保证它在客户端导航时**只执行一次**。
	 */
	(function () {
		if (window.__momoCommentsBooted) return;
		window.__momoCommentsBooted = true;

		var SECTION_SELECTOR = "[data-momo-comment-section]";
		var ROOT_SELECTOR = "[data-momo-comment-root]";
		var ERROR_TEXT = "评论组件加载失败，请刷新页面重试。";
		var loader = null;

		var loadComponent = function (src) {
			if (window.momo) return Promise.resolve(window.momo);
			if (loader) return loader;
			loader = new Promise(function (resolve, reject) {
				var script = document.createElement("script");
				script.src = src;
				script.async = true;
				script.onload = function () {
					if (window.momo) resolve(window.momo);
					else reject(new Error("momo is not registered on window"));
				};
				script.onerror = function () {
					reject(new Error("failed to load comment bundle"));
				};
				document.head.appendChild(script);
			}).catch(function (error) {
				loader = null;
				throw error;
			});
			return loader;
		};

		var mount = function (section) {
			var root = section.querySelector(ROOT_SELECTOR);
			if (!root || !root.id || root.dataset.momoMounted === "1") return;
			var scriptUrl = section.dataset.scriptUrl;
			if (!scriptUrl) return;

			loadComponent(scriptUrl)
				.then(function (momo) {
					// 组件自己会渲染「正在加载评论…」，清掉容器里可能残留的占位/错误文案
					root.replaceChildren();
					momo.init({
						el: "#" + root.id,
						apiUrl: section.dataset.apiUrl,
						slugId: section.dataset.slugId,
						title: section.dataset.postTitle,
						lang: section.dataset.lang,
					});
					root.dataset.momoMounted = "1";
				})
				.catch(function (error) {
					console.error("[momo-comments]", error);
					root.textContent = ERROR_TEXT;
				});
		};

		var init = function () {
			document.querySelectorAll(SECTION_SELECTOR).forEach(mount);
		};

		/*
		 * 解析期就发起组件包请求（不等 page-load），下载与剩余 HTML/CSS 并行；
		 * 同源请求还能复用已有连接。page-load 只负责客户端导航后的重新挂载。
		 */
		var firstSection = document.querySelector(SECTION_SELECTOR);
		if (firstSection && firstSection.dataset.scriptUrl) {
			loadComponent(firstSection.dataset.scriptUrl).catch(function () {
				/* 失败提示在 mount() 里统一处理 */
			});
		}

		document.addEventListener("astro:page-load", init);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>

<style>
	/*
	 * 深色模式不需要单独一套值：下面全部映射到本站 token，而 token 本身
	 * 会随 html[data-theme] 翻转。只有在「本站 token 里没有对应语义」时才
	 * 需要用 [data-theme] 单独覆盖（目前只有验证成功的绿色）。
	 */
	.comment-section {
		--momo-text-color: var(--color-text);
		--momo-button-border-color: var(--color-border);
		--momo-button-hover-bg-color: var(--color-accent-soft);
		--momo-link-color: var(--color-accent);
		--momo-panel-bg: var(--color-surface-elevated);
		--momo-verify-success-color: #15803d;
		--momo-verify-success-border-color: rgba(22, 163, 74, 0.5);
		/* 要越过吸顶导航（与 .article-prose 的 scroll-margin-top 一致） */
		scroll-margin-top: 6.5rem;
		/* 评论区直接坐在页面底色上（不再套玻璃面板），用一条细线与正文分开 */
		padding-top: clamp(1.2rem, 2.4vw, 1.8rem);
		border-top: 1px solid var(--color-border);
		/* 组件里的 em 单位（表单标签、字数提示）以正文字号为基准 */
		font-size: var(--text-md);
	}

	/*
	 * 组件内部全部是 Tailwind 的固定档位，比本站 16px 正文基准小一号：
	 * 评论正文与昵称用 text-sm(14px)、日期与按钮也用 text-sm、表单标签用 text-xs(12px)。
	 * 这两条覆盖把「读的内容」拉回正文字号，辅助文字保持略小于正文。
	 * 选择器需要 :global()—— 这些 DOM 由 bundle 运行时创建，拿不到 Astro 的 scope 属性。
	 */
	:global(.momo-comment-root .text-sm) {
		font-size: var(--text-md);
	}

	:global(.momo-comment-root .text-xs) {
		font-size: 0.82em;
	}

	/*
	 * 组件根自带 `border-t`（为独立使用的站点准备的分隔线）。这里外层已经有
	 * 分隔线，留着会变成上下两条。
	 */
	:global(.momo-comment-root .comment-container) {
		border-top: 0;
	}

	.comment-fallback {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95em;
	}

	:global(html[data-theme="dark"]) .comment-section {
		--momo-verify-success-color: #4ade80;
		--momo-verify-success-border-color: rgba(74, 222, 128, 0.45);
	}
</style>
