---
import "@/styles/post-card.css";
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";
import { siteConfig } from "@/lib/types";

interface Props {
	title: string;
	slug: string;
	excerpt?: string | null;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	coverSide?: "left" | "right";
	variant?: "card" | "list" | "compact";
}

const {
	title,
	slug,
	excerpt,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	coverSide = "left",
	variant = "card",
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const cardClassName = [
	"post-card",
	"glass-panel",
	hasCover
		? coverSide === "right"
			? "post-card-cover-right"
			: "post-card-cover-left"
		: "",
].filter(Boolean).join(" ");
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}

if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}

const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;
const encodedSlug = encodeRouteParam(slug);
---

{
	variant === "compact" ? (
		<article class="post-compact h-entry">
			<a class="u-url" href={`/blog/${encodedSlug}`} hidden>permalink</a>
			{hasCover && (
				<a href={`/blog/${encodedSlug}`} class="post-compact-cover" data-astro-prefetch="hover">
					<img src={coverImageUrl} alt={coverImageAlt} loading="lazy" decoding="async" />
				</a>
			)}
			<div class="post-compact-body">
				<div class="post-compact-meta">
					{categoryName && <span class="post-compact-category p-category">{categoryName}</span>}
					{formattedDate && (
						<time class="post-compact-date local-time-pending dt-published" datetime={publishedAt ?? undefined} data-local-time="date">
							{formattedDate}
						</time>
					)}
				</div>
				<a href={`/blog/${encodedSlug}`} class="post-compact-link" data-astro-prefetch="hover">
					<h3 class="post-compact-title p-name" transition:name={`title-${slug}`}>{title}</h3>
				</a>
				{excerpt && (
					<p class="post-compact-excerpt p-summary" transition:name={`summary-${slug}`}>{excerpt}</p>
				)}
			</div>
		</article>
	) : variant === "list" ? (
		<article class="post-list-item h-entry">
			<a class="u-url" href={`/blog/${encodedSlug}`} hidden>permalink</a>
			<div class="post-list-meta">
				{formattedDate && (
					<time
						class="post-list-date local-time-pending dt-published"
						datetime={publishedAt ?? undefined}
						data-local-time="date"
					>
						{formattedDate}
					</time>
				)}
				{categoryName && <span class="post-list-category p-category">{categoryName}</span>}
			</div>
			<div class="post-list-content">
				<a href={`/blog/${encodedSlug}`} class="post-list-link" data-astro-prefetch="hover">
					<h3 class="post-list-title p-name" transition:name={`title-${slug}`}>{title}</h3>
				</a>
				{excerpt && (
					<p class="post-list-excerpt p-summary" transition:name={`summary-${slug}`}>{excerpt}</p>
				)}
			</div>
		</article>
	) : (
		<article class={cardClassName + " h-entry"}>
			<a class="u-url" href={`/blog/${encodedSlug}`} hidden>permalink</a>
			{hasCover && (
				<a href={`/blog/${encodedSlug}`} class="post-card-cover u-featured" data-astro-prefetch="hover">
					<img src={coverImageUrl} alt={coverImageAlt} loading="lazy" decoding="async" />
				</a>
			)}
			<div class="post-card-content">
				<div class="post-card-top">
					<div class="pill-row" transition:name={`meta-${slug}`}>
						{formattedDate && (
							<time
								class="pill local-time-pending dt-published"
								datetime={publishedAt ?? undefined}
								data-local-time="date"
							>
								{formattedDate}
							</time>
						)}
						{categoryName && <span class="pill p-category">{categoryName}</span>}
			<span class="pill">{articleReadingTimeLabel} · {articleLengthLabel}</span>
					</div>
					<a href={`/blog/${encodedSlug}`} class="post-card-link" data-astro-prefetch="hover">
						<h2 class="post-card-title p-name" transition:name={`title-${slug}`}>{title}</h2>
					</a>
				</div>
				{excerpt && (
					<p class="post-card-excerpt p-summary" transition:name={`summary-${slug}`}>
						{excerpt}
					</p>
				)}
				<div class="post-card-meta">
					<span class="p-author">{authorName || siteConfig.author}</span>
					<a href={`/blog/${encodedSlug}`} class="post-card-readmore" data-astro-prefetch="hover">继续阅读</a>
				</div>
			</div>
		</article>
	)
}
