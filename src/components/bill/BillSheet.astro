	.bill__inkwell {
		display: block;
		width: 100%;
		height: 100%;
		background-image: var(--bill-inkwell);
		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
		pointer-events: none;
	}

	.bill__marker-caption {
		font-family: var(--font-mono);
		font-size: 1.5cqw;
		letter-spacing: 0.3em;
		color: rgb(0 48 110 / 0.6);
	}

	/* 整票边框图：铺满票面最底层。比例 2.37 vs 票面 2.353，横向差 0.7%，
	   fill 拉伸在可接受范围（这是全站唯一允许用 fill 的图） */
	.bill__frame-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: fill;
		mix-blend-mode: multiply;
		pointer-events: none;
		z-index: 0;
	}

	/* 纯装饰区块（无 href）：不响应鼠标，避免遮挡下层可点区块 */
	.bill__zone--deco {
		pointer-events: none;
	}

	/* 组件图区块：图片铺满区块盒，object-fit/混合模式由 artVars 内联给出。
