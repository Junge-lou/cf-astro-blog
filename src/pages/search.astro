---
import { env } from "cloudflare:workers";
import { and, desc, eq, gte, inArray, lte, sql } from "drizzle-orm";
import "@/styles/post-card.css";
import PostCard from "@/components/PostCard.astro";
import SearchBox from "@/components/Search.astro";
import { blogCategories, blogPosts, blogPostTags, blogTags } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats } from "@/lib/format";
import {
	getPublicPostKeywordCondition,
	getPublicPostVisibilityCondition,
} from "@/lib/public-content";
import { sanitizeSlug } from "@/lib/security";

const SEARCH_RESULT_LIMIT = 50;

function normalizeDateInput(value: string | null): string {
	if (!value) {
		return "";
	}

	const normalized = value.trim();
	if (!/^\d{4}-\d{2}-\d{2}$/u.test(normalized)) {
		return "";
	}

	const parsed = new Date(`${normalized}T00:00:00`);
	if (Number.isNaN(parsed.getTime())) {
		return "";
	}

	const [year, month, day] = normalized.split("-").map((item) => Number(item));
	if (
		parsed.getFullYear() !== year ||
		parsed.getMonth() + 1 !== month ||
		parsed.getDate() !== day
	) {
		return "";
	}

	return normalized;
}

const query = Astro.url.searchParams.get("q")?.trim() || "";
const rawSelectedCategory = Astro.url.searchParams.get("category")?.trim().toLowerCase() || "";
const selectedCategory = sanitizeSlug(rawSelectedCategory) || "";
const selectedTags = [
	...new Set(
		Astro.url.searchParams
			.getAll("tags")
			.map((item) => sanitizeSlug(item))
			.filter((item): item is string => Boolean(item)),
	),
];
const selectedDateFrom = normalizeDateInput(Astro.url.searchParams.get("dateFrom"));
const selectedDateTo = normalizeDateInput(Astro.url.searchParams.get("dateTo"));

const hasSearchCriteria = Boolean(
	query || selectedCategory || selectedTags.length > 0 || selectedDateFrom || selectedDateTo,
);

let categories: Array<{ slug: string; name: string }> = [];
let tags: Array<{ slug: string; name: string }> = [];
let results: Array<{
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}> = [];
let totalResults = 0;

try {
	const db = getDb(env.DB);
	const [allCategories, allTags] = await Promise.all([
		db
			.select({ slug: blogCategories.slug, name: blogCategories.name })
			.from(blogCategories)
			.orderBy(blogCategories.name),
		db.select({ slug: blogTags.slug, name: blogTags.name }).from(blogTags).orderBy(blogTags.name),
	]);

	categories = allCategories;
	tags = allTags;

	if (hasSearchCriteria) {
		const conditions = [getPublicPostVisibilityCondition()];

		// 去除 LIKE 通配符，避免用户输入干扰匹配语义
		const keyword = query.replace(/[%_]/gu, " ").trim();
		if (keyword) {
			conditions.push(getPublicPostKeywordCondition(`%${keyword}%`));
		}

		if (selectedCategory) {
			conditions.push(eq(blogCategories.slug, selectedCategory));
		}

		if (selectedDateFrom) {
			conditions.push(gte(blogPosts.publishedAt, `${selectedDateFrom}T00:00:00.000Z`));
		}
		if (selectedDateTo) {
			conditions.push(lte(blogPosts.publishedAt, `${selectedDateTo}T23:59:59.999Z`));
		}

		if (selectedTags.length > 0) {
			conditions.push(
				inArray(
					blogPosts.id,
					db
						.select({ postId: blogPostTags.postId })
						.from(blogPostTags)
						.innerJoin(blogTags, eq(blogPostTags.tagId, blogTags.id))
						.where(inArray(blogTags.slug, selectedTags)),
				),
			);
		}

		const whereCondition = and(...conditions);

		const [countResult] = await db
			.select({ count: sql<number>`count(*)` })
			.from(blogPosts)
			.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
			.where(whereCondition);
		totalResults = countResult?.count ?? 0;

		const rows = await db
			.select({
				title: blogPosts.title,
				slug: blogPosts.slug,
				content: blogPosts.content,
				excerpt: blogPosts.excerpt,
				publishedAt: blogPosts.publishedAt,
				authorName: blogPosts.authorName,
				categoryName: blogCategories.name,
				featuredImageKey: blogPosts.featuredImageKey,
				featuredImageAlt: blogPosts.featuredImageAlt,
			})
			.from(blogPosts)
			.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
			.where(whereCondition)
			.orderBy(desc(blogPosts.publishedAt))
			.limit(SEARCH_RESULT_LIMIT);

		results = rows.map((row) => {
			const readingStats = estimateArticleReadStats(row.content);

			return {
				title: row.title,
				slug: row.slug,
				excerpt: row.excerpt,
				publishedAt: row.publishedAt,
				authorName: row.authorName,
				categoryName: row.categoryName,
				featuredImageKey: row.featuredImageKey,
				featuredImageAlt: row.featuredImageAlt,
				cjkCharCount: readingStats.cjkCharCount,
				latinWordCount: readingStats.latinWordCount,
				estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
			};
		});
	}
} catch {
	// D1 未绑定时回退为空选项与空结果
}

const activeFilters = [
	query ? `关键词：${query}` : "",
	selectedCategory ? `分类：${selectedCategory}` : "",
	selectedTags.length > 0 ? `标签：${selectedTags.join("、")}` : "",
	selectedDateFrom || selectedDateTo
		? `时间：${selectedDateFrom || "不限"} 至 ${selectedDateTo || "不限"}`
		: "",
].filter(Boolean);
---

<Base title="搜索" description="实时检索站内已发布文章的标题、摘要与正文">
	<section
		class="search-hero search-hero-depth glass-panel"
		data-tilt-card
		data-tilt-scale="0.42"
		data-tilt-shift-scale="0.72"
	>
		<span class="section-kicker">站内检索</span>
		<h1 class="page-title">搜索</h1>
		<p class="page-intro">
			搜索由服务端实时查询数据库完成，发文后立即可检索，无需等待索引重建。
		</p>
		<div class="search-entry-stage" transition:name="search-entry">
			<SearchBox
				initialQuery={query}
				categories={categories}
				tags={tags}
				selectedCategory={selectedCategory}
				selectedTags={selectedTags}
				selectedDateFrom={selectedDateFrom}
				selectedDateTo={selectedDateTo}
			/>
		</div>
	</section>

	<section class="search-results-block" id="search-results-section">
		<div class="section-head">
			<div>
				<h2 class="section-heading">搜索结果</h2>
				<p class="section-subheading">
					{activeFilters.length > 0 ? activeFilters.join(" · ") : "输入关键词后开始检索"}
				</p>
			</div>
			<p id="search-results-summary" class="results-summary">
				{hasSearchCriteria
					? totalResults > 0
						? `共找到 ${totalResults} 篇文章${totalResults > results.length ? `，仅显示前 ${results.length} 篇` : ""}`
						: "没有找到相关文章，试试换个关键词或放宽筛选条件"
					: "输入关键词或筛选条件后开始搜索"}
			</p>
		</div>
		<div id="search-results-list" class="search-grid">
			{results.map((post) => (
				<PostCard
					title={post.title}
					slug={post.slug}
					excerpt={post.excerpt}
					publishedAt={post.publishedAt}
					categoryName={post.categoryName}
					authorName={post.authorName}
					featuredImageKey={post.featuredImageKey}
					featuredImageAlt={post.featuredImageAlt}
					cjkCharCount={post.cjkCharCount}
					latinWordCount={post.latinWordCount}
					estimatedReadingMinutes={post.estimatedReadingMinutes}
					variant="list"
				/>
			))}
		</div>
	</section>
</Base>

	<style>
		.search-hero {
			--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
			--glass-panel-blur: var(--hero-card-blur, 18px);
			display: grid;
			gap: 1rem;
			padding: clamp(1.5rem, 1rem + 2vw, 2.6rem);
		}

		.search-hero-depth {
			position: relative;
			overflow: hidden;
			transform:
				perspective(1200px)
				rotateX(var(--tilt-rotate-x, 0deg))
				rotateY(var(--tilt-rotate-y, 0deg))
				scale3d(1.002, 1.002, 1.002);
			transform-style: preserve-3d;
			transition:
				transform var(--nav-motion-surface),
				box-shadow var(--nav-motion-surface);
		}

		.search-hero-depth::before {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: inherit;
			background:
				radial-gradient(
					circle at 18% 24%,
					rgb(var(--color-accent-rgb) / 0.22),
					transparent 38%
				),
				linear-gradient(
					135deg,
					rgba(var(--card-sheen-rgb), 0.16),
					rgba(var(--card-sheen-rgb), 0.02) 58%,
					transparent
				);
			opacity: 0.72;
			pointer-events: none;
			transform: translate3d(
				calc(var(--tilt-shift-x, 0) * -8px),
				calc(var(--tilt-shift-y, 0) * -8px),
				0
			);
			transition: transform var(--nav-motion-surface);
		}

		.search-hero-depth .section-kicker,
		.search-hero-depth .page-title,
		.search-hero-depth .page-intro {
			position: relative;
			z-index: 1;
			transform: translate3d(
				calc(var(--tilt-shift-x, 0) * 2px),
				calc(var(--tilt-shift-y, 0) * 2px),
				14px
			);
			transition: transform var(--nav-motion-surface);
		}

		.search-results-block {
			display: grid;
			gap: 1.2rem;
		}

		.search-entry-stage {
			width: 100%;
		}

		.search-hero-depth .search-entry-stage {
			position: relative;
			z-index: 1;
			transform: translate3d(
				calc(var(--tilt-shift-x, 0) * 4px),
				calc(var(--tilt-shift-y, 0) * 4px),
				24px
			);
			transition: transform var(--nav-motion-surface);
		}

		.section-head {
			display: flex;
			align-items: end;
			justify-content: space-between;
			gap: 1rem;
		}

		.results-summary {
			color: var(--color-text-muted);
			font-size: 0.92rem;
		}

		.search-grid {
			display: grid;
			gap: 1rem;
		}

		@media (max-width: 840px) {
			.section-head {
				flex-direction: column;
				align-items: start;
			}
		}

		@media (hover: none), (pointer: coarse) {
			.search-hero-depth,
			.search-hero-depth::before,
			.search-hero-depth .section-kicker,
			.search-hero-depth .page-title,
			.search-hero-depth .page-intro,
			.search-hero-depth .search-entry-stage {
				transform: none;
			}
		}
	</style>
