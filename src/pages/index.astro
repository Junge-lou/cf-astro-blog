---
import { env } from "cloudflare:workers";
import { and, asc, count, desc, eq } from "drizzle-orm";
import BillSheet from "@/components/bill/BillSheet.astro";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { type BillSettings, DEFAULT_BILL_SETTINGS, getBillSettings } from "@/lib/bill-settings";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats, formatDate } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import {
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let categories: { id: number; name: string; slug: string }[] = [];
let homepageAppearance = DEFAULT_SITE_APPEARANCE;
// 票面几何/文案/字高由后台维护；读失败时退到代码里的默认票面
let billSettings: BillSettings = DEFAULT_BILL_SETTINGS;
// 首页"已发布 N 篇"必须等于归档页的总数，因此单独 count：
// 用 pinned.length + recent.length 只能得到"首页展示了几张"。
let totalPostCount = 0;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	homepageAppearance = await getSiteAppearance(db);
	billSettings = await getBillSettings(db);

	categories = await db
		.select({
			id: blogCategories.id,
			name: blogCategories.name,
			slug: blogCategories.slug,
		})
		.from(blogCategories)
		.orderBy(asc(blogCategories.name));

	const pinnedRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)))
		.orderBy(asc(blogPosts.pinnedOrder), desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
		.limit(3);
	pinnedPosts = pinnedRows.map(toHomePostCardRow);

	const recentRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, false)))
		.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
		.limit(6);
	recentPosts = recentRows.map(toHomePostCardRow);

	const [countRow] = await db
		.select({ value: count() })
		.from(blogPosts)
		.where(getPublicPostVisibilityCondition());
	totalPostCount = Number(countRow?.value ?? 0);
} catch {
	// D1 未绑定时首页退化为空列表
}

const latestPost = [...pinnedPosts, ...recentPosts]
	.filter((post) => Boolean(post.publishedAt))
	.sort(
		(a, b) => new Date(b.publishedAt ?? 0).getTime() - new Date(a.publishedAt ?? 0).getTime(),
	)[0];
const latestUpdateAt = latestPost?.publishedAt || null;
const latestUpdate = latestUpdateAt ? formatDate(latestUpdateAt) : "等待第一篇正式发布的文章";
const recentSectionSubheading =
	pinnedPosts.length > 0 ? "" : "保留最近发布的文章，首页只做精选入口，完整内容请进入归档页查看。";
const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<BillSheet
		siteName={siteConfig.name}
		portraitSrc="/brand-avatar.webp"
		title={homepageAppearance.heroTitle}
		intro={homepageAppearance.heroIntro}
		totalPosts={totalPostCount}
		latestHref={recentPosts[0] ? `/blog/${recentPosts[0].slug}` : "/blog"}
		config={billSettings.config}
		zones={billSettings.zones}
		textMm={billSettings.textMm}
	/>
	{
		categories.length > 0 && (
			<nav class="tags-nav">
				<a href="/blog" class="tags-nav-pill tags-nav-pill-active">全部</a>
				{categories.map((cat) => (
					<a href={`/blog?category=${cat.slug}`} class="tags-nav-pill">{cat.name}</a>
				))}
			</nav>
		)
	}

	{
		pinnedPosts.length > 0 && (
			<>
				<section class="section-head">
					<div>
						<h2 class="section-heading">置顶文章</h2>
					</div>
				</section>

				<div class="post-compact-grid">
					{pinnedPosts.map((post, index) => (
						<PostCard
							title={post.title}
							slug={post.slug}
							excerpt={post.excerpt}
							publishedAt={post.publishedAt}
							authorName={post.authorName}
							categoryName={post.categoryName}
							featuredImageKey={post.featuredImageKey}
							featuredImageAlt={post.featuredImageAlt}
							cjkCharCount={post.cjkCharCount}
							latinWordCount={post.latinWordCount}
							estimatedReadingMinutes={post.estimatedReadingMinutes}
							variant="compact"
						/>
					))}
				</div>
			</>
		)
	}

	<section class="section-head">
		<div>
			<h2 class="section-heading">最近更新</h2>
			<p class="section-subheading">
				{recentSectionSubheading}
			</p>
		</div>
		{
			/* 服务端先给一份可读文案；带 datetime 时再交给 local-time.js
			   按访客本地时区重绘，脚本失效也不会变成空白。 */
			latestUpdateAt ? (
				<time class="section-meta" datetime={latestUpdateAt} data-local-time="date">
					{latestUpdate}
				</time>
			) : (
				<p class="section-meta">{latestUpdate}</p>
			)
		}
	</section>

	{recentPosts.length > 0 ? (
		<div class="home-list">
			{recentPosts.map((post, index) => (
				<PostCard
					title={post.title}
					slug={post.slug}
					excerpt={post.excerpt}
					publishedAt={post.publishedAt}
					authorName={post.authorName}
					categoryName={post.categoryName}
					featuredImageKey={post.featuredImageKey}
					featuredImageAlt={post.featuredImageAlt}
					cjkCharCount={post.cjkCharCount}
					latinWordCount={post.latinWordCount}
					estimatedReadingMinutes={post.estimatedReadingMinutes}
					variant="list"
				/>
			))}
		</div>
	) : (
		<div class="empty-state glass-panel">
			<p>还没有公开文章，先去后台发布第一篇内容。</p>
		</div>
	)}
	<script is:inline src="/home-motion.js"></script>
</Base>

<style>
/* 首页样式 —— 只保留票面 + 分类 + 置顶卡 + 最近更新 这四块真正存在的结构。
 * 曾经的「Hero 双栏 / 侧栏信号卡」以及后来那版「单栏玻璃 Hero」
 * （home-hero-copy、hero-body、hero-actions、hero-kbd、hero-divider、hero-stats…）
 * 在 Hero 换成票面组件后已全部失去引用，于本次一并删除。 */
	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-head .section-kicker {
		margin-bottom: 0.8rem;
	}

	/* 最近更新于…：右侧时间戳，等宽数字保证不同日期不会把行宽顶来顶去 */
	.section-meta {
		flex: none;
		margin: 0;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-variant-numeric: tabular-nums;
		color: var(--color-text-secondary);
	}

	.tags-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tags-nav-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.38rem 1rem;
		border-radius: var(--radius-pill);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		background: rgba(var(--card-surface-rgb), 0.08);
		border: 1px solid var(--color-border);
		backdrop-filter: blur(8px) saturate(120%);
		-webkit-backdrop-filter: blur(8px) saturate(120%);
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition),
			transform var(--transition);
		text-decoration: none;
	}

	.tags-nav-pill:hover {
		background: rgba(var(--card-surface-rgb), 0.16);
		border-color: rgb(var(--color-accent-rgb) / 0.24);
		color: var(--color-text);
		transform: translateY(-1px);
	}

	.tags-nav-pill-active,
	.tags-nav-pill-active:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.home-list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
	}

	/* 卡片入场：错峰延迟由下面的 nth-child 规则提供，
	   这里只声明一次动画本身（之前只留了延迟、没有 animation 声明，那批延迟全是死代码） */
	.home-list :global(.post-list-item),
	.post-compact-grid :global(.post-compact) {
		animation: home-float-in 780ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.home-list :global(.post-list-item:nth-child(1)) {
		animation-delay: 80ms;
	}

	.home-list :global(.post-list-item:nth-child(2)) {
		animation-delay: 130ms;
	}

	.home-list :global(.post-list-item:nth-child(3)) {
		animation-delay: 180ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(1)) {
		animation-delay: 80ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(2)) {
		animation-delay: 130ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(3)) {
		animation-delay: 180ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(4)) {
		animation-delay: 230ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(5)) {
		animation-delay: 280ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(6)) {
		animation-delay: 330ms;
	}

	@keyframes home-float-in {
		from {
			opacity: 0;
			transform: translate3d(0, 26px, 0) scale(0.985);
		}

		to {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@media (max-width: 960px) {
		.section-head {
			flex-direction: column;
			align-items: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bill__zone {
			animation: none;
			transition: none;
			transform: none;
		}
	}
</style>
