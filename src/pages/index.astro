---
import { env } from "cloudflare:workers";
import { and, asc, count, desc, eq } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats, formatDate } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import {
	buildHeroActionLinks,
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let categories: { id: number; name: string; slug: string }[] = [];
let homepageAppearance = DEFAULT_SITE_APPEARANCE;
// 首页"已发布 N 篇"必须等于归档页的总数，因此单独 count：
// 用 pinned.length + recent.length 只能得到"首页展示了几张"。
let totalPostCount = 0;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	homepageAppearance = await getSiteAppearance(db);

	categories = await db
		.select({
			id: blogCategories.id,
			name: blogCategories.name,
			slug: blogCategories.slug,
		})
		.from(blogCategories)
		.orderBy(asc(blogCategories.name));

	const pinnedRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)))
		.orderBy(asc(blogPosts.pinnedOrder), desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
		.limit(3);
	pinnedPosts = pinnedRows.map(toHomePostCardRow);

	const recentRows = await db
		.select({
			title: blogPosts.title,
			slug: blogPosts.slug,
			content: blogPosts.content,
			excerpt: blogPosts.excerpt,
			publishedAt: blogPosts.publishedAt,
			authorName: blogPosts.authorName,
			categoryName: blogCategories.name,
			featuredImageKey: blogPosts.featuredImageKey,
			featuredImageAlt: blogPosts.featuredImageAlt,
		})
		.from(blogPosts)
		.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
		.where(and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, false)))
		.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
		.limit(6);
	recentPosts = recentRows.map(toHomePostCardRow);

	const [countRow] = await db
		.select({ value: count() })
		.from(blogPosts)
		.where(getPublicPostVisibilityCondition());
	totalPostCount = Number(countRow?.value ?? 0);
} catch {
	// D1 未绑定时首页退化为空列表
}

const latestPost = [...pinnedPosts, ...recentPosts]
	.filter((post) => Boolean(post.publishedAt))
	.sort(
		(a, b) => new Date(b.publishedAt ?? 0).getTime() - new Date(a.publishedAt ?? 0).getTime(),
	)[0];
const latestUpdateAt = latestPost?.publishedAt || null;
const latestUpdate = latestUpdateAt ? formatDate(latestUpdateAt) : "等待第一篇正式发布的文章";
const recentSectionSubheading =
	pinnedPosts.length > 0 ? "" : "保留最近发布的文章，首页只做精选入口，完整内容请进入归档页查看。";
const heroActions = buildHeroActionLinks(homepageAppearance);
const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<section class="home-hero-copy glass-panel">
		<div class="hero-body">
			<span class="section-kicker">{homepageAppearance.heroKicker}</span>
			<h1 class="page-title">{homepageAppearance.heroTitle}</h1>
			<p class="page-intro">{homepageAppearance.heroIntro}</p>
			<div class="hero-divider" aria-hidden="true"></div>
			<div class="hero-actions">
				{
					heroActions.map((action, index) => (
						index === 1 ? (
							<span class="hero-search-bridge" transition:name="search-entry">
								<a
									href={action.href}
									class:list={["button", { "button-secondary": index > 0 }]}
									target={isInternalHref(action.href) ? undefined : "_blank"}
									rel={isInternalHref(action.href) ? undefined : "noopener noreferrer"}
								>
									{action.label}
									<kbd class="hero-kbd">Ctrl K</kbd>
								</a>
							</span>
						) : (
							<a
								href={action.href}
								class:list={["button", { "button-secondary": index > 0 }]}
								target={isInternalHref(action.href) ? undefined : "_blank"}
								rel={isInternalHref(action.href) ? undefined : "noopener noreferrer"}
							>
								{action.label}
							</a>
						)
					))
				}
			</div>
			<div class="hero-stats">
				<span>📝 已发布 <strong>{totalPostCount}</strong> 篇文章</span>
				{latestUpdateAt && (
					<time class="local-time-pending" datetime={latestUpdateAt} data-local-time="date">
						最后更新于 {latestUpdate}
					</time>
				)}
			</div>
		</div>
	</section>

	{
		categories.length > 0 && (
			<nav class="tags-nav">
				<a href="/blog" class="tags-nav-pill tags-nav-pill-active">全部</a>
				{categories.map((cat) => (
					<a href={`/blog?category=${cat.slug}`} class="tags-nav-pill">{cat.name}</a>
				))}
			</nav>
		)
	}

	{
		pinnedPosts.length > 0 && (
			<>
				<section class="section-head">
					<div>
						<h2 class="section-heading">置顶文章</h2>
					</div>
				</section>

				<div class="post-compact-grid">
					{pinnedPosts.map((post, index) => (
						<PostCard
							title={post.title}
							slug={post.slug}
							excerpt={post.excerpt}
							publishedAt={post.publishedAt}
							authorName={post.authorName}
							categoryName={post.categoryName}
							featuredImageKey={post.featuredImageKey}
							featuredImageAlt={post.featuredImageAlt}
							cjkCharCount={post.cjkCharCount}
							latinWordCount={post.latinWordCount}
							estimatedReadingMinutes={post.estimatedReadingMinutes}
							variant="compact"
						/>
					))}
				</div>
			</>
		)
	}

	<section class="section-head">
		<div>
			<h2 class="section-heading">最近更新</h2>
		</div>
		<p class="section-subheading">
			{recentSectionSubheading}
		</p>
	</section>

	{recentPosts.length > 0 ? (
		<div class="home-list">
			{recentPosts.map((post, index) => (
				<PostCard
					title={post.title}
					slug={post.slug}
					excerpt={post.excerpt}
					publishedAt={post.publishedAt}
					authorName={post.authorName}
					categoryName={post.categoryName}
					featuredImageKey={post.featuredImageKey}
					featuredImageAlt={post.featuredImageAlt}
					cjkCharCount={post.cjkCharCount}
					latinWordCount={post.latinWordCount}
					estimatedReadingMinutes={post.estimatedReadingMinutes}
					variant="list"
				/>
			))}
		</div>
	) : (
		<div class="empty-state glass-panel">
			<p>还没有公开文章，先去后台发布第一篇内容。</p>
		</div>
	)}
	<script is:inline src="/home-motion.js"></script>
</Base>

<style>
/* 首页样式 —— 只保留 Hero 单栏 + 分类 + 置顶卡 + 最近更新 这四块真正存在的结构。
 * 曾经的「Hero 双栏 / 侧栏信号卡」那套样式（home-hero-main、home-hero-side、
 * hero-main-media、hero-signal-*、hero-metric、hero-atmosphere/aura/beam/grid…）
 * 在模板改单栏后已经全部失去引用，于 1.7 一并删除。 */
	.home-hero-copy.glass-panel {
		--glass-panel-blur: var(--hero-card-blur, 18px);
		position: relative;
		display: grid;
		gap: clamp(0.8rem, 1.5vw, 1.2rem);
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto;
		padding: clamp(1rem, 2vw, 1.8rem) clamp(1.2rem, 2.5vw, 2.2rem);
		overflow: hidden;
	}

	.home-hero-copy.glass-panel::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(var(--color-accent-rgb) / 0.04), transparent 60%),
			radial-gradient(ellipse at 80% 100%, rgba(var(--card-sheen-rgb), 0.03), transparent 50%);
	}

	.home-hero-copy.glass-panel > * {
		position: relative;
		z-index: 2;
	}

	.hero-body {
		display: grid;
		gap: 0.85rem;
		align-content: start;
		min-width: 0;
	}

	.home-hero-copy .page-title {
		font-size: var(--text-4xl);
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.home-hero-copy .page-intro {
		white-space: pre-line;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 0.4rem;
	}

	.hero-search-bridge {
		display: inline-flex;
	}

	.hero-kbd {
		display: inline-flex;
		align-items: center;
		margin-left: 0.4rem;
		padding: 0.1em 0.4em;
		border-radius: 6px;
		border: 1px solid rgba(var(--card-sheen-rgb), 0.24);
		background: rgba(var(--card-sheen-rgb), 0.1);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.4;
		opacity: 0.7;
	}

	.hero-actions .button-secondary {
		border: none;
		background: rgba(var(--card-sheen-rgb), 0.13);
	}

	.hero-actions .button-secondary:hover {
		background: rgba(var(--card-sheen-rgb), 0.19);
	}

	/* 入场错峰：只作用于 Hero 正文的直接子元素 */
	.hero-body > * {
		animation: home-float-in 780ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-body > :nth-child(1) {
		animation-delay: 40ms;
	}

	.hero-body > :nth-child(2) {
		animation-delay: 120ms;
	}

	.hero-body > :nth-child(3) {
		animation-delay: 190ms;
	}

	.hero-body > :nth-child(4) {
		animation-delay: 260ms;
	}

	.hero-body > :nth-child(5) {
		animation-delay: 330ms;
	}

	.hero-body > :nth-child(6) {
		animation-delay: 400ms;
	}

	.hero-divider {
		width: 4rem;
		height: 3px;
		border-radius: 2px;
		background: linear-gradient(
			90deg,
			var(--color-accent),
			rgb(var(--color-accent-rgb) / 0.2)
		);
		margin-top: 0.2rem;
	}

	.hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-top: 0.2rem;
	}

	.hero-stats strong {
		color: var(--color-text-secondary);
		font-weight: 650;
	}

	.hero-stats time {
		color: var(--color-text-muted);
	}

	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-head .section-kicker {
		margin-bottom: 0.8rem;
	}

	.tags-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tags-nav-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.38rem 1rem;
		border-radius: var(--radius-pill);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		background: rgba(var(--card-surface-rgb), 0.08);
		border: 1px solid var(--color-border);
		backdrop-filter: blur(8px) saturate(120%);
		-webkit-backdrop-filter: blur(8px) saturate(120%);
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition),
			transform var(--transition);
		text-decoration: none;
	}

	.tags-nav-pill:hover {
		background: rgba(var(--card-surface-rgb), 0.16);
		border-color: rgb(var(--color-accent-rgb) / 0.24);
		color: var(--color-text);
		transform: translateY(-1px);
	}

	.tags-nav-pill-active,
	.tags-nav-pill-active:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.home-list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
	}

	.home-list :global(.post-list-item:nth-child(1)) {
		animation-delay: 80ms;
	}

	.home-list :global(.post-list-item:nth-child(2)) {
		animation-delay: 130ms;
	}

	.home-list :global(.post-list-item:nth-child(3)) {
		animation-delay: 180ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(1)) {
		animation-delay: 80ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(2)) {
		animation-delay: 130ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(3)) {
		animation-delay: 180ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(4)) {
		animation-delay: 230ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(5)) {
		animation-delay: 280ms;
	}

	.post-compact-grid :global(.post-compact:nth-child(6)) {
		animation-delay: 330ms;
	}

	@keyframes home-float-in {
		from {
			opacity: 0;
			transform: translate3d(0, 26px, 0) scale(0.985);
		}

		to {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1);
		}
	}

	@media (max-width: 960px) {
		.section-head {
			flex-direction: column;
			align-items: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-body > * {
			animation: none;
			transition: none;
			transform: none;
		}
	}
</style>
