---
import CommentsPanel from "@/components/CommentsPanel.astro";
import FabMenu from "@/components/FabMenu.astro";
import WebmentionPanel from "@/components/WebmentionPanel.astro";
import { formatDate } from "@/lib/format";
import type { MarkdownTocItem } from "@/lib/security";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	publishedAt?: string;
	authorName?: string;
	categoryName?: string;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	backgroundOverride?: {
		imageKey: string;
		opacity: number;
		blur: number;
		scale: number;
		positionX: number;
		positionY: number;
	};
	toc?: MarkdownTocItem[];
}

const {
	slug,
	title,
	description,
	image,
	canonicalUrl,
	publishedAt,
	authorName,
	categoryName,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	backgroundOverride,
	toc,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}

if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}

const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;
const tocEntries = (toc ?? [])
	.map((item) => ({
		...item,
		level:
			Number.isInteger(item.level) && item.level >= 2 && item.level <= 4
				? item.level
				: 2,
		text: item.text.trim(),
	}))
	.filter((item) => item.id && item.text);
const hasToc = tocEntries.length > 0;
---

<Base
	title={title}
	description={description}
	image={image}
	canonicalUrl={canonicalUrl}
	backgroundOverride={backgroundOverride}
>
	<article
		class:list={["article-shell", "h-entry", { "article-shell-no-sidebar": !hasToc }]}
		id="post-content"
	>
		<a class="u-url" href={canonicalUrl || Astro.url.href} hidden>permalink</a>
		{hasToc && (
			<aside class="article-sidebar">
				<nav class="article-toc glass-panel" aria-label="文章目录">
					<div class="article-toc-head">
						<span>目录</span>
						<button
							type="button"
							class="article-transparency-toggle article-transparency-toggle-compact"
							data-article-transparency-toggle="true"
							aria-pressed="false"
						>
							取消透明度
						</button>
					</div>
					<div class="article-toc-body">
						<ol class="article-toc-list">
							{tocEntries.map((item) => (
								<li class={`article-toc-item level-${item.level}`}>
									<a href={`#${item.id}`} class="article-toc-link" data-toc-id={item.id}>
										{item.text}
									</a>
								</li>
							))}
						</ol>
					</div>
				</nav>
			</aside>
		)}
		<div class="article-main">
			<header class="article-hero glass-panel">
				<div class="article-hero-tools">
					<a href="/blog" class="article-back">返回归档</a>
					<button
						type="button"
						class="article-transparency-toggle"
						data-article-transparency-toggle="true"
						aria-pressed="false"
					>
						取消透明度
					</button>
					<div class="article-hero-stats" aria-label="文章字数与阅读时间">
						<span class="article-hero-stat">{articleLengthLabel}</span>
						<span class="article-hero-stat">{articleReadingTimeLabel}</span>
					</div>
				</div>
				<div class="article-kicker">精选文章</div>
				<h1 class="article-title p-name" transition:name={`title-${slug}`}>{title}</h1>
				{description && (
					<p class="article-summary p-summary" transition:name={`summary-${slug}`}>
						{description}
					</p>
				)}
				<div class="pill-row" transition:name={`meta-${slug}`}>
					{formattedDate && (
						<time
							class="pill local-time-pending dt-published"
							datetime={publishedAt}
							data-local-time="date"
						>
							{formattedDate}
						</time>
					)}
					{authorName && <span class="pill p-author">{authorName}</span>}
					{categoryName && <span class="pill p-category">{categoryName}</span>}
				</div>
			</header>
			<div class="article-body glass-panel e-content">
					<div class="prose article-prose">
						<slot />
					</div>
				</div>
				<div class="article-webmention-card glass-panel">
					<WebmentionPanel targetUrl={canonicalUrl || Astro.url.href} />
				</div>
				<div class="article-comments-card glass-panel">
					<CommentsPanel title={title} slug={slug} />
				</div>
			</div>
		</article>
	<FabMenu tocEntries={tocEntries} />
	<script is:inline src="/code-block-enhance.js"></script>
	<script is:inline src="/diagram-render.js"></script>
	<script is:inline src="/article-transparency-toggle.js"></script>
	<script is:inline src="/article-toc-highlight.js"></script>
	<script is:inline src="/article-reveal.js"></script>
</Base>

<style>
	.article-shell {
		display: grid;
		grid-template-columns: minmax(13.5rem, 17rem) minmax(0, 1fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.article-shell-no-sidebar {
		grid-template-columns: minmax(0, 1fr);
	}

	.article-main {
		display: grid;
		gap: var(--space-xl);
	}

	.article-sidebar {
		--article-sidebar-sticky-top: 6.5rem;
		align-self: stretch;
		display: grid;
		align-content: start;
		grid-auto-rows: max-content;
	}

	/*
	 * 目录：借鉴 claude.css 大纲的树状结构（引导竖线 + 圆点标记 + 悬停/激活反馈）。
	 * 高度超出视口时内部滚动，与大纲面板的阅读习惯一致。
	 */
	.article-toc {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 1.1rem 1.15rem 0.9rem;
		position: sticky;
		top: var(--article-sidebar-sticky-top);
		/* 目录高度上限 50vh（对齐 Momo 的 h-[50vh]），同时不超过视口 */
		max-height: min(50vh, calc(100vh - var(--article-sidebar-sticky-top) - 1.2rem));
	}

	.article-toc-head {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding-bottom: 0.72rem;
		margin-bottom: 0.6rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-toc-body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overflow-x: hidden;
		/* 细滚动条 */
		scrollbar-width: none;
		padding: 0.2rem 0.1rem 0.25rem 0;
	}

	.article-toc-body::-webkit-scrollbar {
		display: none;
	}

	.article-toc-head > span {
		display: block;
		font-size: 0.78rem;
		line-height: 1.5;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 700;
		font-family: var(--font-strong);
		color: var(--color-text-muted);
	}

	.article-transparency-toggle-compact {
		padding: 0.38rem 0.62rem;
		font-size: 0.76rem;
		line-height: 1.1;
		white-space: nowrap;
	}

	/* 树状目录主体：单根竖线 + 逐项圆点 */
	.article-toc-list {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.14rem;
	}

	/* 左侧引导竖线（两端渐隐） */
	.article-toc-list::before {
		content: "";
		position: absolute;
		left: 8px;
		top: 0.45rem;
		bottom: 0.45rem;
		width: 1px;
		background: linear-gradient(
			180deg,
			transparent,
			var(--color-accent) 5%,
			var(--color-accent) 95%,
			transparent
		);
		opacity: 0.4;
	}

	.article-toc-item {
		position: relative;
		margin: 0;
		padding-left: 1.4rem;
	}

	.article-toc-item.level-3 {
		padding-left: 2.1rem;
	}

	.article-toc-item.level-4 {
		padding-left: 2.8rem;
	}

	/* 目录项圆点 */
	.article-toc-item::before {
		content: "";
		position: absolute;
		left: 5px;
		top: 50%;
		transform: translateY(-50%);
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-accent);
		opacity: 0.38;
		transition:
			opacity var(--duration-normal) ease,
			box-shadow var(--duration-normal) ease,
			transform var(--duration-normal) ease;
	}

	.article-toc-item:hover::before,
	.article-toc-item:has(.article-toc-link.active)::before {
		opacity: 1;
		transform: translateY(-50%) scale(1.1);
		box-shadow: 0 0 0 4px var(--color-accent-soft);
	}

	.article-toc-link {
		display: block;
		padding: 0.3rem 0.55rem;
		border-radius: 0.45rem;
		font-size: 0.875rem;
		line-height: 1.55;
		font-family: var(--font-strong);
		font-weight: 450;
		color: var(--color-text-secondary);
		transition:
			color var(--duration-normal) ease,
			background-color var(--duration-normal) ease;
	}

	/* hover：强调色文字 + 轻微底色，仿 claude.css outline 悬停反馈 */
	.article-toc-link:hover {
		color: var(--color-accent);
		background: var(--color-accent-soft);
	}

	/* 当前阅读章节高亮（由 article-toc-highlight.js 动态添加 .active 类） */
	.article-toc-link.active {
		color: var(--color-accent);
		background: var(--color-accent-soft);
		font-weight: 550;
	}

	/*
	 * slot 内容由父组件注入，子代选择器在 Astro scoped CSS 中仍会附加 [data-astro-cid]
	 * 必须将整个选择器包在 :global() 内才能匹配 slot 插入的标题元素
	 */
	:global(.article-prose :is(h1, h2, h3, h4, h5, h6)[id]) {
		scroll-margin-top: 6.5rem;
	}

	.article-hero,
	.article-body,
	.article-webmention-card {
		padding: clamp(1.4rem, 1rem + 2vw, 2.5rem);
	}

	.article-hero {
		display: grid;
		gap: 1rem;
	}

	.article-hero-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
	}

	.article-hero-stats {
		margin-left: auto;
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.article-hero-stat {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		padding: 0.58rem 0.92rem;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: var(--color-text-secondary);
		font-size: 0.84rem;
		font-family: var(--font-strong);
		backdrop-filter: blur(10px) saturate(120%);
		-webkit-backdrop-filter: blur(10px) saturate(120%);
	}

	.article-back,
	.article-transparency-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		padding: 0.58rem 0.92rem;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: var(--color-text-secondary);
		font-size: 0.88rem;
		backdrop-filter: blur(10px) saturate(120%);
		-webkit-backdrop-filter: blur(10px) saturate(120%);
	}

	.article-transparency-toggle {
		cursor: pointer;
		font-family: inherit;
	}

	.article-transparency-toggle:hover,
	.article-transparency-toggle:focus-visible,
	.article-back:hover,
	.article-back:focus-visible {
		border-color: rgba(135, 190, 255, 0.42);
		background: rgba(255, 255, 255, 0.12);
		color: var(--color-text);
		outline: none;
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel {
		background: rgba(var(--card-surface-rgb), 0.96);
		border-color: rgba(255, 255, 255, 0.14);
		box-shadow: 0 14px 34px -28px rgba(8, 18, 34, 0.52);
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::after {
		background: rgba(var(--card-surface-rgb), 0.98);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::before {
		opacity: 0.22;
	}

	:global(html.article-opaque-mode) .article-shell .article-back,
	:global(html.article-opaque-mode) .article-shell .article-transparency-toggle,
	:global(html.article-opaque-mode) .article-shell .article-hero-stat {
		background: rgba(var(--card-surface-rgb), 0.94);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-color: rgba(255, 255, 255, 0.16);
		color: var(--color-text);
	}

	.article-kicker {
		font-size: 0.82rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.article-title {
		font-size: clamp(2.4rem, 1.8rem + 2vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
	}

	.article-summary {
		max-width: 42rem;
		font-size: 1.04rem;
		line-height: 1.9;
		color: var(--color-text-secondary);
	}

	/* 文章主列各面板统一为阅读列宽并居中（与 claude.css 正文 752px 一致），
	 * 使 hero / 正文 / 评论区左右边缘对齐，形成协调的纵向阅读节奏 */
	.article-hero,
	.article-body,
	.article-webmention-card,
	.article-comments-card {
		margin-inline: auto;
		width: 100%;
		max-width: var(--max-width-prose);
	}

	.article-prose {
		margin-inline: auto;
	}

	/* 评论卡片内 CommentsPanel 融入外层 glass-panel，去掉自带的边框、背景和圆角 */
	:global(.article-comments-card .comments-panel),
	:global(.article-webmention-card .wm-section) {
		border: none;
		background: transparent;
		border-radius: 0;
		overflow: visible;
	}
	:global(html.article-opaque-mode .article-comments-card .comments-panel),
	:global(html.article-opaque-mode .article-webmention-card .wm-section) {
		background: transparent;
	}

	@media (max-width: 1024px) {
		.article-shell {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			align-self: start;
			position: static;
			top: auto;
		}

		.article-toc {
			position: static;
			top: auto;
			max-height: none;
		}

		.article-toc-body {
			overflow-y: visible;
		}
	}

	@media (max-width: 900px), (orientation: portrait) and (max-width: 1180px) {
		.article-shell {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.article-hero-stats {
			margin-left: 0;
			width: 100%;
			justify-content: flex-start;
		}
	}
</style>
