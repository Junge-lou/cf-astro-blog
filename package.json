{
	"name": "cf-astro-blog-starter",
	"version": "1.7.0",
	"type": "module",
	"private": true,
	"description": "基于 Astro、Hono 与 Cloudflare Workers 的内置后台站点模板",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:analyze": "npm run build && node scripts/analyze-build.mjs",
		"preview": "npm run sync:posts:local && npm run build && wrangler dev",
		"deploy": "npm run db:migrate:remote && astro build && node scripts/analyze-build.mjs --json && wrangler deploy",
		"sync:posts": "node scripts/sync-local-posts.mjs --remote",
		"sync:posts:local": "node scripts/sync-local-posts.mjs --local",
		"export:posts": "node scripts/export-posts.mjs --remote",
		"export:posts:local": "node scripts/export-posts.mjs --local",
		"check": "astro check && npm run typecheck && biome check src public tests scripts",
		"check:fix": "biome check --write src public tests scripts",
		"typecheck": "tsc --noEmit",
		"typecheck:ts6": "tsc6 --noEmit --tsBuildInfoFile node_modules/.cache/tsconfig.ts6.tsbuildinfo",
		"format": "biome format --write src public tests scripts README.md astro.config.mjs",
		"lint": "biome lint src public tests scripts",
		"test": "tsx --test tests/integration/*.test.ts tests/unit/*.test.ts",
		"hash:password": "node scripts/hash-password.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "wrangler d1 execute DB --local --file=scripts/seed.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed.sql",
		"analyze": "node scripts/analyze-build.mjs",
		"fonts:payload": "node scripts/analyze-font-payload.mjs",
		"smoke": "node scripts/smoke-test.mjs",
		"media:optimize": "node scripts/optimize-media.mjs --fetch --apply --mirror",
		"media:status": "node scripts/optimize-media.mjs --status"
	},
	"cloudflare": {
		"bindings": {
			"DB": {
				"description": "用于文章、分类、标签和统计数据的 D1 数据库"
			},
			"MEDIA_BUCKET": {
				"description": "用于媒体文件上传的 R2 存储桶"
			},
			"SESSION": {
				"description": "用于后台会话和登录限流的 KV 命名空间"
			},
			"JWT_SECRET": {
				"description": "建议使用 `openssl rand -hex 32` 生成随机密钥"
			},
			"ADMIN_USERNAME": {
				"description": "管理后台登录用户名"
			},
			"ADMIN_PASSWORD_HASH": {
				"description": "后台密码的 PBKDF2 哈希，使用 `npm run hash:password -- 你的密码` 生成"
			},
			"TURNSTILE_SECRET_KEY": {
				"description": "可选的 Cloudflare Turnstile 密钥，用于登录人机验证"
			}
		}
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.2",
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"astro": "^7.4.2",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.14",
		"jose": "^6.2.13",
		"katex": "^0.19.1",
		"marked": "^18.1.2",
		"node-emoji": "^2.2.0",
		"sanitize-html": "^2.18.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.3",
		"@cloudflare/workers-types": "^5.20261028.1",
		"@remy/webmention": "^1.5.0",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"drizzle-kit": "^0.31.11",
		"gray-matter": "^4.0.3",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"wrangler": "^4.154.0"
	},
	"overrides": {
		"minimist": "^1.2.8",
		"nth-check": "^2.0.1",
		"miniflare": {
			"undici": "^7.30.1"
		}
	}
}
